@page "/Error/{statusCode:int?}"
@model PlatformHub.Mvc.Pages.ErrorModel
@{
    Layout = null;
    ViewData["Title"] = "PlatformHub · Error Center";
    var isServerError = Model.StatusCode >= 500;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"]</title>
<style>
:root{--ink:#17263a;--muted:#64748b;--blue:#246bfe;--line:#dce5f0;--page:#f2f5fa}
*{box-sizing:border-box}html,body{min-height:100%;margin:0}body{min-height:100vh;min-height:100dvh;color:var(--ink);background:radial-gradient(ellipse at 8% 0%,rgba(36,107,254,.1),transparent 38rem),radial-gradient(ellipse at 100% 100%,rgba(37,99,235,.08),transparent 35rem),var(--page);font-family:Inter,system-ui,-apple-system,"Segoe UI",sans-serif}
.error-shell{min-height:100vh;min-height:100dvh;display:flex;flex-direction:column}.topbar{min-height:60px;padding:10px clamp(16px,3vw,36px);display:flex;align-items:center;justify-content:space-between;gap:16px;color:#fff;background:#172638;border-bottom:1px solid #314157}
.brand{display:flex;align-items:center;gap:12px;color:inherit;text-decoration:none;font-size:1.15rem;font-weight:750}.brand-mark{display:grid;place-items:center;width:40px;height:40px;border-radius:12px;background:#3478f6;font-weight:850;font-size:1.2rem}.top-label{color:#b7c5d8;font-size:.9rem}
main{flex:1;width:100%;display:grid;place-items:center;padding:clamp(10px,2vh,22px) clamp(12px,2vw,28px)}.card{width:min(100%,1320px);overflow:hidden;border:1px solid var(--line);border-radius:18px;background:#fff;box-shadow:0 16px 44px rgba(23,38,58,.09)}
.hero{position:relative;overflow:hidden;padding:clamp(22px,2.6vw,34px);color:#fff;background:linear-gradient(120deg,#172638,#244675)}.hero:after{content:"";position:absolute;width:300px;height:300px;border-radius:50%;right:-90px;top:-170px;border:1px solid #ffffff20;box-shadow:0 0 0 35px #ffffff08,0 0 0 75px #ffffff05;pointer-events:none}
.eyebrow{position:relative;z-index:1;margin-bottom:15px;color:#bcd2ff;font-size:.76rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase}.hero h1{position:relative;z-index:1;max-width:850px;margin:0 0 12px;font-size:clamp(1.8rem,4vw,3rem);line-height:1.12;font-weight:780;letter-spacing:-.035em}.hero p{position:relative;z-index:1;max-width:780px;margin:0;color:#d5dfed;font-size:clamp(1rem,1.7vw,1.18rem);line-height:1.65}
.content{padding:clamp(18px,2.2vw,28px)}.status-row{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:18px}.status{display:inline-flex;border-radius:999px;padding:7px 12px;font-size:.83rem;font-weight:800}.status-error{color:#b42318;background:#fff0ef}.status-warning{color:#8a5200;background:#fff7e5}.reference{min-width:0;color:var(--muted);font-size:.84rem;overflow-wrap:anywhere}.reference code,.diagnostics code{color:#bd2861;overflow-wrap:anywhere;white-space:normal}
.grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:20px}.section-title{margin:0 0 10px;font-size:1.05rem;font-weight:800}.explanation{color:var(--muted);line-height:1.7}.actions-list{display:grid;gap:12px;padding:0;margin:18px 0 0;list-style:none}.actions-list li{position:relative;padding-left:29px;color:#475569;line-height:1.55}.actions-list li:before{content:"✓";position:absolute;left:0;top:1px;display:grid;place-items:center;width:19px;height:19px;border-radius:50%;color:#2163d7;background:#eaf1ff;font-size:.75rem;font-weight:900}
.diagnostics{padding:16px;border:1px solid var(--line);border-radius:13px;background:#f8fafd}.diagnostics dl{display:grid;grid-template-columns:minmax(85px,.35fr) minmax(0,1fr);gap:9px 12px;margin:12px 0 0;font-size:.84rem}.diagnostics dt{color:var(--muted);font-weight:600}.diagnostics dd{min-width:0;margin:0;overflow-wrap:anywhere}
.technical{margin-top:18px;border:1px solid var(--line);border-radius:12px;padding:14px 16px}.technical summary{cursor:pointer;font-weight:700}.technical pre{max-height:280px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;color:#475569}
.buttons{display:flex;flex-wrap:wrap;gap:9px;margin-top:20px}.btn{min-height:40px;display:inline-flex;align-items:center;justify-content:center;border:1px solid #cbd5e1;border-radius:9px;padding:8px 14px;color:#334155;background:#fff;text-decoration:none;font:inherit;font-weight:600;font-size:.9rem;cursor:pointer}.btn-primary{color:#fff;background:var(--blue);border-color:var(--blue)}.note{margin:22px 0 0;color:var(--muted);font-size:.84rem;line-height:1.6}.footer{padding:0 20px 20px;color:#8491a4;text-align:center;font-size:.78rem}
@@media(max-width:760px){.topbar{min-height:56px;padding:9px 13px}.top-label{display:none}main{padding:10px 8px 16px;align-items:start}.card{border-radius:13px}.hero{padding:22px 18px}.content{padding:16px}.grid{grid-template-columns:minmax(0,1fr);gap:18px}.diagnostics{padding:14px}.diagnostics dl{grid-template-columns:minmax(78px,.35fr) minmax(0,1fr);gap:8px}.buttons{display:grid;grid-template-columns:minmax(0,1fr)}.btn{width:100%}.note{margin-top:16px}}
@@media(prefers-reduced-motion:no-preference){.card{animation:enter .25s ease-out both}
@@keyframes enter{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:translateY(0)}}}
</style>
</head>
<body>
<div class="error-shell">
<header class="topbar"><a class="brand" href="/"><span class="brand-mark">P</span><span>PlatformHub</span></a><span class="top-label">Control Center · Error diagnostics</span></header>
<main><article class="card">
<section class="hero"><div class="eyebrow">PlatformHub · Error Center</div><h1>@Model.Title</h1><p>@Model.Description</p></section>
<div class="content">
<div class="status-row"><span class="status @(isServerError ? "status-error" : "status-warning")">HTTP @Model.StatusCode</span><span class="reference">Reference: <code>@Model.TraceId</code></span></div>
<div class="grid">
<section><h2 class="section-title">What happened?</h2><p class="explanation">@Model.Explanation</p>
@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div role="alert" style="margin-top:16px;padding:13px 15px;border:1px solid #f4d7a1;border-radius:10px;background:#fff8e8;color:#79521b;overflow-wrap:anywhere"><strong>Additional details:</strong> @Model.ErrorMessage</div>
}<h2 class="section-title" style="margin-top:26px">Recommended actions</h2><ul class="actions-list">@foreach (var action in Model.SuggestedActions){<li>@action</li>}</ul></section>
<aside class="diagnostics" aria-label="Request diagnostics"><h2 class="section-title">Diagnostic information</h2><dl><dt>Request</dt><dd><code>@Model.RequestMethod @Model.RequestPath@Model.QueryString</code></dd><dt>HTTP status</dt><dd>@Model.StatusCode</dd><dt>Environment</dt><dd>@Model.EnvironmentName</dd><dt>Reference ID</dt><dd><code>@Model.TraceId</code></dd></dl></aside>
</div>
@if (!string.IsNullOrWhiteSpace(Model.TechnicalDetails)){<details class="technical"><summary>Technical details (Development only)</summary><pre>@Model.TechnicalDetails</pre></details>}
<nav class="buttons" aria-label="Error recovery"><button type="button" class="btn btn-primary" onclick="window.location.reload()">Try again</button><a class="btn" href="@Model.LoginUrl">@Model.LoginButtonText</a><a class="btn" href="/">Go to home</a><button type="button" class="btn" onclick="if(history.length>1)history.back();else window.location.href='/'">Go back</button></nav>
<p class="note">If this problem continues, share the reference ID with your administrator and check the PlatformHub.Mvc and PlatformHub.Api logs. Sensitive exception details are not shown outside Development.</p>
</div></article></main>
<footer class="footer">PlatformHub · Secure workspace management</footer>
</div>
</body>
</html>
