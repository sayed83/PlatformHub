@page "/Error/{statusCode:int?}"
@model PlatformHub.Mvc.Pages.ErrorModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Error Center";
    var isServerError = Model.StatusCode >= 500;
}
<style>
.ph-error-card{overflow:hidden;border:1px solid #dce5f0;border-radius:16px;background:#fff;box-shadow:0 12px 32px rgba(23,38,58,.08);margin:1rem auto 2rem;max-width:1320px}
.ph-error-hero{position:relative;overflow:hidden;padding:clamp(22px,2.6vw,34px);color:#fff;background:linear-gradient(120deg,#172638,#244675);border-radius:15px 15px 0 0}
.ph-error-hero:after{content:"";position:absolute;width:260px;height:260px;border-radius:50%;right:-90px;top:-170px;border:1px solid #ffffff20;box-shadow:0 0 0 35px #ffffff08,0 0 0 75px #ffffff05;pointer-events:none}
.ph-error-eyebrow{position:relative;z-index:1;margin-bottom:12px;color:#bcd2ff;font-size:.76rem;font-weight:800;letter-spacing:.15em;text-transform:uppercase}
.ph-error-hero h1{position:relative;z-index:1;margin:0 0 10px;font-size:clamp(1.8rem,4vw,2.7rem);line-height:1.12;font-weight:780;letter-spacing:-.035em}
.ph-error-hero p{position:relative;z-index:1;max-width:780px;margin:0;color:#d5dfed;font-size:1.08rem;line-height:1.6}
.ph-error-content{padding:clamp(18px,2.2vw,28px)}
.ph-error-status-row{display:flex;flex-wrap:wrap;align-items:center;gap:10px;margin-bottom:18px}
.ph-error-status{display:inline-flex;border-radius:999px;padding:7px 12px;font-size:.83rem;font-weight:800}
.ph-error-status-danger{color:#b42318;background:#fff0ef}.ph-error-status-warning{color:#8a5200;background:#fff7e5}
.ph-error-reference{min-width:0;color:#64748b;font-size:.84rem;overflow-wrap:anywhere}
.ph-error-reference code,.ph-error-diagnostics code{color:#bd2861;overflow-wrap:anywhere;white-space:normal}
.ph-error-grid{display:grid;grid-template-columns:minmax(0,1.15fr) minmax(280px,.85fr);gap:20px}
.ph-error-title{margin:0 0 10px;font-size:1.05rem;font-weight:800}
.ph-error-explanation{color:#64748b;line-height:1.7}
.ph-error-actions{display:grid;gap:12px;padding:0;margin:18px 0 0;list-style:none}
.ph-error-actions li{position:relative;padding-left:29px;color:#475569;line-height:1.55}
.ph-error-actions li:before{content:"✓";position:absolute;left:0;top:1px;display:grid;place-items:center;width:19px;height:19px;border-radius:50%;color:#2163d7;background:#eaf1ff;font-size:.75rem;font-weight:900}
.ph-error-diagnostics{padding:16px;border:1px solid #dce5f0;border-radius:13px;background:#f8fafd}
.ph-error-diagnostics dl{display:grid;grid-template-columns:minmax(85px,.35fr) minmax(0,1fr);gap:9px 12px;margin:12px 0 0;font-size:.84rem}
.ph-error-diagnostics dt{color:#64748b;font-weight:600}.ph-error-diagnostics dd{min-width:0;margin:0;overflow-wrap:anywhere}
.ph-error-technical{margin-top:18px;border:1px solid #dce5f0;border-radius:12px;padding:14px 16px}
.ph-error-technical summary{cursor:pointer;font-weight:700}.ph-error-technical pre{max-height:320px;overflow:auto;white-space:pre-wrap;overflow-wrap:anywhere;color:#475569;margin-top:12px}
.ph-error-buttons{display:flex;flex-wrap:wrap;gap:9px;margin-top:20px}
.ph-error-buttons .btn{min-height:40px;display:inline-flex;align-items:center;justify-content:center;border-radius:9px;padding:8px 14px;font-weight:600;font-size:.9rem}
.ph-error-note{margin:22px 0 0;color:#64748b;font-size:.84rem;line-height:1.6}
@@media(max-width:760px){.ph-error-grid{grid-template-columns:minmax(0,1fr);gap:18px}.ph-error-diagnostics{padding:14px}.ph-error-diagnostics dl{grid-template-columns:minmax(78px,.35fr) minmax(0,1fr);gap:8px}.ph-error-buttons{display:grid;grid-template-columns:minmax(0,1fr)}.ph-error-buttons .btn{width:100%}.ph-error-content{padding:16px}.ph-error-hero{padding:22px 18px}}
</style>

<article class="ph-error-card" role="alert">
    <section class="ph-error-hero">
        <div class="ph-error-eyebrow">PlatformHub · Error Center</div>
        <h1>@Model.Title</h1>
        <p>@Model.Description</p>
    </section>
    <div class="ph-error-content">
        <div class="ph-error-status-row">
            <span class="ph-error-status @(isServerError ? "ph-error-status-danger" : "ph-error-status-warning")">HTTP @Model.StatusCode</span>
            <span class="ph-error-reference">Reference: <code>@Model.TraceId</code></span>
        </div>
        <div class="ph-error-grid">
            <section>
                <h2 class="ph-error-title">What happened?</h2>
                <p class="ph-error-explanation">@Model.Explanation</p>
                <h2 class="ph-error-title mt-4">Recommended actions</h2>
                <ul class="ph-error-actions">
                    @foreach (var action in Model.SuggestedActions)
                    {
                        <li>@action</li>
                    }
                </ul>
            </section>
            <aside class="ph-error-diagnostics" aria-label="Request diagnostics">
                <h2 class="ph-error-title">Diagnostic information</h2>
                <dl>
                    <dt>Request</dt><dd><code>@Model.RequestMethod @Model.RequestPath@Model.QueryString</code></dd>
                    <dt>HTTP status</dt><dd>@Model.StatusCode</dd>
                    <dt>Environment</dt><dd>@Model.EnvironmentName</dd>
                    <dt>Reference ID</dt><dd><code>@Model.TraceId</code></dd>
                </dl>
            </aside>
        </div>
        @if (Model.EnvironmentName.Equals("Development", StringComparison.OrdinalIgnoreCase))
        {
            <details class="ph-error-technical">
                <summary>Actual error details (Development only)</summary>
                @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
                {
                    <p class="mt-3"><strong>Service message:</strong> @Model.ErrorMessage</p>
                }
                @if (!string.IsNullOrWhiteSpace(Model.TechnicalDetails))
                {
                    <pre>@Model.TechnicalDetails</pre>
                }
                else
                {
                    <p class="mt-3 mb-0 text-secondary">No additional exception details were captured for this request. Use the reference ID above to locate the corresponding MVC/API log entry.</p>
                }
            </details>
        }
        <nav class="ph-error-buttons" aria-label="Error recovery">
            <button type="button" class="btn btn-primary" onclick="window.location.reload()">Try again</button>
            <a class="btn btn-outline-secondary" href="@Model.LoginUrl">@Model.LoginButtonText</a>
            <a class="btn btn-outline-secondary" href="/">Go to home</a>
            <button type="button" class="btn btn-outline-secondary" onclick="if(history.length>1)history.back();else window.location.href='/'">Go back</button>
        </nav>
        <p class="ph-error-note">If this problem continues, share the reference ID with your administrator and check the PlatformHub.Mvc and PlatformHub.Api logs. Sensitive exception details are not shown outside Development.</p>
    </div>
</article>
