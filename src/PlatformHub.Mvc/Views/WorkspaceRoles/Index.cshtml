@model IReadOnlyList<PlatformHub.Mvc.Controllers.WorkspaceRoleRowViewModel>
@{
    ViewData["Title"] = "Workspace Roles";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var search = ViewData["Search"] as string ?? "";
    var canCreate = User.HasClaim("ph_permission", "Role.Create");
    var canUpdate = User.HasClaim("ph_permission", "Role.Update");
    var canDeactivate = User.HasClaim("ph_permission", "Role.Deactivate");
}
<div class="container-fluid py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="text-uppercase small fw-semibold text-secondary mb-1">Workspace · Access control</div>
            <h1 class="h3 mb-1">Roles &amp; Permissions</h1>
            <p class="text-secondary mb-0">Roles assigned within your active workspace scope.</p>
        </div>
        <div class="d-flex align-items-center gap-2"><span class="badge text-bg-primary">@Model.Count role(s)</span>@if (canCreate) { <button class="btn btn-primary" type="button" data-bs-toggle="collapse" data-bs-target="#createRole">Create role</button> }</div>
    </div>

    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success">@success</div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
    @if (canCreate) { <div class="collapse mb-3" id="createRole"><div class="card card-body shadow-sm"><h2 class="h5">Create tenant custom role</h2><form method="post" action="/WorkspaceRoles/create">@Html.AntiForgeryToken()<div class="row g-2"><div class="col-md-3"><label class="form-label">Role code</label><input class="form-control" name="Code" maxlength="100" required /></div><div class="col-md-3"><label class="form-label">Role name</label><input class="form-control" name="Name" maxlength="150" required /></div><div class="col-md-3"><label class="form-label">Description</label><input class="form-control" name="Description" maxlength="500" /></div><div class="col-md-3"><label class="form-label">Landing page</label><input class="form-control" name="BaseRedirectUrl" maxlength="500" /></div></div><button class="btn btn-primary mt-3">Save role</button></form></div></div> }
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form method="get" action="/WorkspaceRoles" class="row g-2 mb-3">
                <div class="col-12 col-md-8 col-lg-6">
                    <label class="form-label" for="search">Search roles</label>
                    <input class="form-control" id="search" name="search" value="@search"
                           placeholder="Role name or code" maxlength="100" />
                </div>
                <div class="col-auto align-self-end">
                    <button class="btn btn-primary" type="submit">Search</button>
                    <a class="btn btn-outline-secondary" href="/WorkspaceRoles">Clear</a>
                </div>
            </form>

            @if (Model.Count == 0)
            {
                <div class="text-center py-5">
                    <h2 class="h5">No roles found</h2>
                    <p class="text-secondary mb-0">No active roles are assigned within this workspace, or your search returned no matches.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr><th>Role</th><th>Code</th><th>Users in scope</th><th>Permissions</th><th>Landing page</th><th>Status</th><th>Actions</th></tr>
                        </thead>
                        <tbody>
                        @foreach (var role in Model)
                        {
                            <tr>
                                <td><div class="fw-semibold">@role.Name</div><small class="text-secondary">@role.Description</small>@if (role.TenantId.HasValue) { <span class="badge text-bg-info ms-1">Tenant custom</span> } else { <span class="badge text-bg-secondary ms-1">System</span> }</td>
                                <td><code>@role.Code</code></td>
                                <td><span class="badge text-bg-light border">@role.UserCount</span></td>
                                <td>
                                    @if (role.Permissions.Count == 0) { <span class="text-secondary">No permissions</span> }
                                    else
                                    {
                                        <details>
                                            <summary>@role.Permissions.Count permission(s)</summary>
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @foreach (var permission in role.Permissions)
                                                {
                                                    <span class="badge rounded-pill text-bg-light border">@permission</span>
                                                }
                                            </div>
                                        </details>
                                    }
                                </td>
                                <td><small class="text-secondary">@(string.IsNullOrWhiteSpace(role.BaseRedirectUrl) ? "Workspace default" : role.BaseRedirectUrl)</small></td>
                                <td><span class="badge @(role.IsActive ? "text-bg-success" : "text-bg-secondary")">@(role.IsActive ? "Active" : "Inactive")</span></td>
                                <td><div class="d-flex flex-wrap gap-1">
                                @if (role.TenantId.HasValue && canUpdate) { <details><summary class="btn btn-sm btn-outline-primary">Edit</summary><form method="post" action="/WorkspaceRoles/edit" class="border rounded p-2 mt-2">@Html.AntiForgeryToken()<input type="hidden" name="Id" value="@role.Id" /><input class="form-control form-control-sm mb-1" name="Name" value="@role.Name" maxlength="150" required /><input class="form-control form-control-sm mb-1" name="Description" value="@role.Description" maxlength="500" /><input class="form-control form-control-sm mb-1" name="BaseRedirectUrl" value="@role.BaseRedirectUrl" maxlength="500" /><button class="btn btn-sm btn-primary">Save</button></form></details> }
                                @if (role.TenantId.HasValue && (role.IsActive ? canDeactivate : canUpdate)) { <form method="post" action="/WorkspaceRoles/status">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@role.Id" /><input type="hidden" name="isActive" value="@(!role.IsActive)" /><button class="btn btn-sm @(role.IsActive ? "btn-outline-danger" : "btn-outline-success")">@(role.IsActive ? "Deactivate" : "Activate")</button></form> }
                                </div></td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
    <div class="alert alert-info mt-3 mb-0">
        <strong>Security:</strong> Custom roles belong to this tenant only. Global system roles are read-only here. API endpoints enforce permissions and tenant scope independently of these controls.
    </div>
</div>
