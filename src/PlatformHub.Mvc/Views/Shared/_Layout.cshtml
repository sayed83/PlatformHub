<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - PlatformHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet">
    <style>
        :root { --ph-sidebar: #182433; --ph-sidebar-muted: #aebdd0; --ph-accent: #367cf7; }
        html, body { min-height: 100%; width:100%; }
        body { min-height: 100vh; overflow-x: hidden; }
        .ph-topbar { background: var(--ph-sidebar); min-height: 62px; }
        .ph-brand-mark { width: 34px; height: 34px; display:inline-flex; align-items:center; justify-content:center; border-radius:9px; background:var(--ph-accent); color:#fff; font-weight:800; }
        .ph-admin-shell { display:flex; min-height:calc(100vh - 62px); width:100%; max-width:100vw; }
        .ph-sidebar { width:250px; flex:0 0 250px; background:var(--ph-sidebar); color:#fff; padding:1.25rem .85rem; }
        .ph-sidebar-inner.is-collapsed { display:none; }
        .ph-nav-label { color:#8194ac; font-size:.68rem; font-weight:700; letter-spacing:.12em; padding:.85rem .8rem .45rem; text-transform:uppercase; }
        .ph-sidebar .nav-link { color:var(--ph-sidebar-muted); border-radius:.6rem; padding:.7rem .8rem; display:flex; align-items:center; gap:.7rem; margin:.12rem 0; }
        .ph-sidebar .nav-link:hover { color:#fff; background:rgba(255,255,255,.08); }
        .ph-sidebar .nav-link.active { color:#fff; background:rgba(54,124,247,.23); box-shadow:inset 3px 0 0 var(--ph-accent); }
        .ph-sidebar .nav-link .ph-nav-icon { width:1.2rem; text-align:center; opacity:.9; flex:0 0 1.2rem; }
        .ph-admin-content { min-width:0; width:calc(100% - 250px); flex:1 1 0; padding:1.5rem clamp(1rem,2.5vw,2rem); overflow-x:auto; }
        .ph-admin-content > * { max-width:100%; }
        .ph-user-chip { border:1px solid rgba(255,255,255,.18); border-radius:2rem; padding:.35rem .75rem; color:#e7edf5; font-size:.85rem; max-width:280px; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
        .ph-mobile-menu { display:none; }
        @@media (max-width: 767.98px) {
            .ph-topbar .container-fluid { gap:.5rem; }
            .ph-brand-mark { width:30px; height:30px; }
            .ph-brand-text { font-size:1rem; }
            .ph-mobile-menu { display:inline-flex; align-items:center; justify-content:center; gap:.4rem; }
            .ph-user-chip { display:none !important; }
            .ph-admin-shell { display:flex; flex-direction:column; min-height:calc(100vh - 58px); }
            .ph-sidebar { width:100%; flex:0 0 auto; padding:0; }
            .ph-sidebar-inner.is-collapsed { display:none; }
            .ph-sidebar-inner { padding:.65rem .85rem .9rem; border-top:1px solid rgba(255,255,255,.08); }
            .ph-nav-label { padding:.55rem .7rem .35rem; }
            .ph-sidebar .nav-link { min-height:44px; padding:.65rem .75rem; margin:.12rem 0; }
            .ph-sidebar .nav-link .ph-nav-icon { display:inline-block; }
            .ph-admin-content { width:100%; padding:1rem .85rem 1.5rem; overflow-wrap:anywhere; }
            .ph-admin-content .display-6 { font-size:1.8rem; }
            .ph-admin-content .table-responsive { max-width:100%; }
        }
        @@media (max-width: 380px) {
            .ph-brand-text { font-size:.92rem; }
            .ph-brand-subtitle { display:none; }
            .ph-mobile-menu .ph-menu-text { display:none; }
            .ph-admin-content { padding:.85rem .65rem 1.25rem; }
        }
    </style>
</head>
<body class="bg-light">
@{
    var isPlatformAdmin = User.Identity?.IsAuthenticated == true
        && User.FindFirst("ph_platform_admin")?.Value == "true";
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    var showAdminShell = isPlatformAdmin && !(string.Equals(currentArea, "PlatformAdmin", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentController, "Account", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentAction, "Login", StringComparison.OrdinalIgnoreCase));
    var canViewRoles = User.HasClaim("ph_permission", "Role.View");
    var canViewUsers = User.HasClaim("ph_permission", "User.View");
    string Active(string controller) =>
        string.Equals(currentArea, "PlatformAdmin", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
            ? "active" : string.Empty;
}
<header class="ph-topbar navbar navbar-dark py-2">
    <div class="container-fluid px-3 px-lg-4">
        <a class="navbar-brand d-flex align-items-center gap-2 mb-0 me-auto" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="ph-brand-mark">P</span>
            <span class="fw-semibold ph-brand-text">PlatformHub <span class="text-white-50 small fw-normal ph-brand-subtitle">@(showAdminShell ? "· Control Center" : "")</span></span>
        </a>
        @if (showAdminShell)
        {
            <span class="ph-user-chip">Administrator · @User.FindFirst("ph_display_name")?.Value</span>
            <button class="btn btn-outline-light btn-sm ph-mobile-menu" type="button"
                    aria-controls="phAdminNav" aria-expanded="false" aria-label="Toggle administration menu">
                <span aria-hidden="true">☰</span><span class="ph-menu-text">Menu</span>
            </button>
            <form asp-area="PlatformAdmin" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
            </form>
        }
        else if (User.Identity?.IsAuthenticated == true && !isPlatformAdmin)
        {
            <nav class="d-flex align-items-center gap-2 gap-lg-3 me-2" aria-label="Main navigation">
                <a class="nav-link text-white px-2 py-1" asp-area="" asp-controller="Workspace" asp-action="Index">Workspace</a>
            </nav>
            <span class="ph-user-chip d-none d-lg-inline">@User.FindFirst("ph_display_name")?.Value</span>
            <form asp-area="" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
            </form>
        }
    </div>
</header>

@if (showAdminShell)
{
    <div class="ph-admin-shell">
        <aside class="ph-sidebar">
            <div id="phAdminNav" class="ph-sidebar-inner">
                <div class="ph-nav-label">Platform</div>
                <nav class="nav flex-column" aria-label="Platform administration">
                    <a class="nav-link @Active("Dashboard")" asp-area="PlatformAdmin" asp-controller="Dashboard" asp-action="Index">
                        <span class="ph-nav-icon" aria-hidden="true">▦</span> Dashboard
                    </a>
                    <a class="nav-link @Active("Tenants")" asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index">
                        <span class="ph-nav-icon" aria-hidden="true">▣</span> Tenants &amp; branches
                    </a>
                    <a class="nav-link @Active("Projects")" asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Index">
                        <span class="ph-nav-icon" aria-hidden="true">◈</span> Projects
                    </a>
                    @if (canViewUsers)
                    {
                        <a class="nav-link @Active("Users")" asp-area="PlatformAdmin" asp-controller="Users" asp-action="Index">
                            <span class="ph-nav-icon" aria-hidden="true">♙</span> Users &amp; access
                        </a>
                    }
                    @if (canViewRoles)
                    {
                        <a class="nav-link @Active("Roles")" asp-area="PlatformAdmin" asp-controller="Roles" asp-action="Index">
                            <span class="ph-nav-icon" aria-hidden="true">⚿</span> Roles &amp; permissions
                        </a>
                    }
                    <a class="nav-link @Active("MenuAccess")" asp-area="PlatformAdmin" asp-controller="MenuAccess" asp-action="Index">
                        <span class="ph-nav-icon" aria-hidden="true">♙</span> Menu access
                    </a>
                    <a class="nav-link @Active("MenuManagement")" asp-area="PlatformAdmin" asp-controller="MenuManagement" asp-action="Index">
                        <span class="ph-nav-icon" aria-hidden="true">☷</span> Project menus
                    </a>
                </nav>
                <div class="small mt-4 px-2" style="color:#8194ac">SECURE PLATFORM ADMINISTRATION</div>
            </div>
        </aside>
        <main class="ph-admin-content">@RenderBody()</main>
    </div>
}
else
{
    <main class="container py-4">@RenderBody()</main>
}
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
.select2-container{width:100%!important}.select2-container--default .select2-selection--single{height:38px;border:1px solid #ced4da;border-radius:.375rem;display:flex;align-items:center}.select2-container--default .select2-selection--single .select2-selection__rendered{line-height:36px;padding-left:.75rem;color:var(--bs-body-color)}.select2-container--default .select2-selection--single .select2-selection__arrow{height:36px;right:.35rem}.select2-dropdown{z-index:2000;border-color:#ced4da}.select2-container--open{z-index:2001}.swal2-container{z-index:30000!important}
</style>
<script>
(function(){
 function initSelect2(root){
  if(!window.jQuery||!jQuery.fn.select2)return;
  if(jQuery(root).closest('.swal2-container').length||jQuery(root).is('.swal2-container')||jQuery(root).closest('.swal2-popup').length)return;
  jQuery(root).find('select').addBack('select').each(function(){
   const el=jQuery(this);
   if(el.hasClass('select2-hidden-accessible')||el.is('[data-select2="off"]'))return;
   const modal=el.closest('.modal');
   el.select2({width:'100%',placeholder:el.attr('data-placeholder')||'Select an option',allowClear:el.is('[data-allow-clear="true"]'),dropdownParent:modal.length?modal:jQuery(document.body)});
  });
 }
 document.addEventListener('DOMContentLoaded',function(){
  initSelect2(document);
  const menuButton=document.querySelector('.ph-mobile-menu');
  const adminNav=document.getElementById('phAdminNav');
  const mobileNav=window.matchMedia('(max-width: 767.98px)');
  function syncAdminNav(){
   if(!adminNav||!menuButton)return;
   if(mobileNav.matches){
    adminNav.classList.add('is-collapsed');
    menuButton.setAttribute('aria-expanded','false');
   }else{
    adminNav.classList.remove('is-collapsed');
    menuButton.setAttribute('aria-expanded','true');
   }
  }
  syncAdminNav();
  if(menuButton&&adminNav){
   menuButton.addEventListener('click',function(){
    if(!mobileNav.matches)return;
    const collapsed=adminNav.classList.toggle('is-collapsed');
    menuButton.setAttribute('aria-expanded',String(!collapsed));
   });
   adminNav.querySelectorAll('a.nav-link').forEach(link=>link.addEventListener('click',function(){
    if(mobileNav.matches){adminNav.classList.add('is-collapsed');menuButton.setAttribute('aria-expanded','false');}
   }));
   if(mobileNav.addEventListener)mobileNav.addEventListener('change',syncAdminNav);
   else mobileNav.addListener(syncAdminNav);
  }
  new MutationObserver(records=>records.forEach(record=>record.addedNodes.forEach(node=>{if(node.nodeType===1)initSelect2(node)}))).observe(document.body,{childList:true,subtree:true});
  document.addEventListener('submit',async function(event){
   const form=event.target, message=form&&form.getAttribute&&form.getAttribute('data-confirm');
   if(!message||form.dataset.confirmed==='true')return;
   event.preventDefault();
   if(window.jQuery&&jQuery.fn.select2)jQuery('select.select2-hidden-accessible').each(function(){const el=jQuery(this);if(el.select2('isOpen'))el.select2('close');});
   const hard=form.querySelector('input[name="hardDelete"][value="true"]');
   const result=await Swal.fire({title:hard?'Permanently delete?':'Please confirm',text:message,icon:hard?'warning':'question',showCancelButton:true,confirmButtonText:hard?'Yes, permanently delete':'Confirm',cancelButtonText:'Cancel',confirmButtonColor:hard?'#dc3545':'#0d6efd',reverseButtons:true,focusCancel:true});
   if(result.isConfirmed){form.dataset.confirmed='true';form.requestSubmit();}
  });
  const success=document.querySelector('.alert-success[role="status"]'), error=document.querySelector('.alert-danger[role="alert"]');
  if(success&&success.textContent.trim())Swal.fire({icon:'success',title:'Success',text:success.textContent.trim(),timer:3000,showConfirmButton:false});
  else if(error&&error.textContent.trim()) {
   const errorText=error.textContent.trim();
   const needsRoleLink=/role assignments|role assignment/i.test(errorText);
   Swal.fire({
    icon:'error',
    title:'Action failed',
    text:errorText,
    showDenyButton:needsRoleLink,
    denyButtonText:'Manage roles & permissions',
    confirmButtonText:'OK',
    reverseButtons:true
   }).then(result=>{
    if(result.isDenied) window.location.href='/PlatformAdmin/Roles';
   });
  }
 });
})();
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
