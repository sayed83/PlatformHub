<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - PlatformHub</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root { --ph-sidebar: #182433; --ph-sidebar-muted: #aebdd0; --ph-accent: #367cf7; }
        body { min-height: 100vh; }
        .ph-topbar { background: var(--ph-sidebar); }
        .ph-brand-mark { width: 34px; height: 34px; display:inline-flex; align-items:center; justify-content:center; border-radius:9px; background:var(--ph-accent); color:#fff; font-weight:800; }
        .ph-admin-shell { display:flex; min-height:calc(100vh - 62px); }
        .ph-sidebar { width:250px; flex:0 0 250px; background:var(--ph-sidebar); color:#fff; padding:1.25rem .85rem; }
        .ph-nav-label { color:#8194ac; font-size:.68rem; font-weight:700; letter-spacing:.12em; padding:.85rem .8rem .45rem; text-transform:uppercase; }
        .ph-sidebar .nav-link { color:var(--ph-sidebar-muted); border-radius:.6rem; padding:.7rem .8rem; display:flex; align-items:center; gap:.7rem; margin:.12rem 0; }
        .ph-sidebar .nav-link:hover { color:#fff; background:rgba(255,255,255,.08); }
        .ph-sidebar .nav-link.active { color:#fff; background:rgba(54,124,247,.23); box-shadow:inset 3px 0 0 var(--ph-accent); }
        .ph-sidebar .nav-link .ph-nav-icon { width:1.2rem; text-align:center; opacity:.9; }
        .ph-admin-content { min-width:0; flex:1; padding:1.5rem clamp(1rem,2.5vw,2rem); }
        .ph-user-chip { border:1px solid rgba(255,255,255,.18); border-radius:2rem; padding:.35rem .75rem; color:#e7edf5; font-size:.85rem; }
        @@media (max-width: 767.98px) {
            .ph-admin-shell { display:block; }
            .ph-sidebar { width:100%; padding:.55rem .75rem; }
            .ph-sidebar .ph-nav-list { display:flex; gap:.35rem; overflow-x:auto; padding-bottom:.15rem; }
            .ph-sidebar .nav-link { white-space:nowrap; margin:0; padding:.55rem .7rem; }
            .ph-nav-label, .ph-sidebar .ph-nav-icon { display:none; }
            .ph-admin-content { padding:1rem; }
        }
    </style>
</head>
<body class="bg-light">
@{
    var isPlatformAdmin = User.Identity?.IsAuthenticated == true
        && User.FindFirst("ph_platform_admin")?.Value == "true";
    var currentArea = ViewContext.RouteData.Values["area"]?.ToString();
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string controller, string? action = null) =>
        string.Equals(currentArea, "PlatformAdmin", StringComparison.OrdinalIgnoreCase)
        && string.Equals(currentController, controller, StringComparison.OrdinalIgnoreCase)
        && (action is null || string.Equals(currentAction, action, StringComparison.OrdinalIgnoreCase))
            ? "active" : string.Empty;
}
<header class="ph-topbar navbar navbar-dark py-2">
    <div class="container-fluid px-3 px-lg-4">
        <a class="navbar-brand d-flex align-items-center gap-2 mb-0" asp-area="" asp-controller="Home" asp-action="Index">
            <span class="ph-brand-mark">P</span>
            <span class="fw-semibold">PlatformHub <span class="text-white-50 small fw-normal">@(isPlatformAdmin ? "· Control Center" : "")</span></span>
        </a>
        @if (isPlatformAdmin)
        {
            <div class="d-flex align-items-center gap-3">
                <span class="ph-user-chip d-none d-sm-inline">Administrator · @User.FindFirst("ph_display_name")?.Value</span>
                <form asp-area="PlatformAdmin" asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-light">Sign out</button>
                </form>
            </div>
        }
    </div>
</header>

@if (isPlatformAdmin)
{
    <div class="ph-admin-shell">
        <aside class="ph-sidebar">
            <div class="ph-nav-label">Platform</div>
            <nav class="ph-nav-list nav flex-column" aria-label="Platform administration">
                <a class="nav-link @Active("Dashboard")" asp-area="PlatformAdmin" asp-controller="Dashboard" asp-action="Index">
                    <span class="ph-nav-icon">▦</span> Dashboard
                </a>
                <a class="nav-link @Active("Tenants")" asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index">
                    <span class="ph-nav-icon">▣</span> Tenants & branches
                </a>
                <a class="nav-link @Active("Projects")" asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Index">
                    <span class="ph-nav-icon">◈</span> Projects
                </a>
            </nav>
            <div class="ph-nav-label mt-3">Account</div>
            <nav class="ph-nav-list nav flex-column" aria-label="Account">
                <a class="nav-link" asp-area="PlatformAdmin" asp-controller="Account" asp-action="Logout" onclick="event.preventDefault(); this.closest('aside').parentElement.querySelector('header form')?.requestSubmit();">
                    <span class="ph-nav-icon">↪</span> Sign out
                </a>
            </nav>
            <div class="small mt-4 px-2" style="color:#8194ac">SECURE PLATFORM ADMINISTRATION</div>
        </aside>
        <main class="ph-admin-content">@RenderBody()</main>
    </div>
}
else
{
    <main class="container py-4">@RenderBody()</main>
}
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
