@model PlatformHub.Mvc.Models.WorkspaceViewModel
@{
    ViewData["Title"] = "Workspace";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var scopeIndex = Context.Request.Query["scopeIndex"].ToString();
    var isFirstVisit = string.IsNullOrWhiteSpace(scopeIndex);
}
<style>
    .ws-hero { background:linear-gradient(120deg,#182433,#263f5c); color:#fff; border-radius:1rem; }
    .ws-card { transition:transform .15s ease, box-shadow .15s ease; height:100%; }
    .ws-card:hover { transform:translateY(-2px); box-shadow:0 .5rem 1.2rem rgba(20,35,55,.10); }
    .ws-icon { width:44px;height:44px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:#eaf1ff;color:#245fd1;font-size:1.3rem; }
</style>
<div class="container-fluid px-0">
    <div class="ws-hero p-4 p-lg-5 mb-4 shadow-sm">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
            <div>
                <div class="small text-uppercase fw-semibold mb-2" style="letter-spacing:.12em;color:#b9d0f6">PlatformHub · User Workspace</div>
                <h1 class="display-6 fw-semibold mb-2">Welcome, @Model.DisplayName</h1>
                <p class="mb-0 text-white-50">Your workspace is based on your assigned roles and access scope.</p>
            </div>
            <div class="text-lg-end">
                <div class="small text-white-50">Signed in as</div>
                <div class="fw-semibold">@Model.UserName</div>
                <div class="d-flex flex-wrap gap-1 mt-2 justify-content-lg-end">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge rounded-pill text-bg-light">@role</span>
                    }
                </div>
            </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }

    @if (Model.Scopes.Count == 0)
    {
        <div class="alert alert-warning border-0 shadow-sm">
            <h2 class="h5">No workspace assigned yet</h2>
            <p class="mb-2">Your account is active, but it has no valid active tenant, branch, or project assignment.</p>
            <p class="mb-0">Ask a Platform Admin to assign a role with the correct scope, then sign out and sign in again.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-lg-4">
                <div class="d-flex flex-column flex-lg-row align-items-lg-end justify-content-between gap-3">
                    <div>
                        <h2 class="h5 mb-1">Choose your workspace</h2>
                        <p class="text-secondary mb-0 small">Only active scopes assigned to your account are listed.</p>
                    </div>
                    <form method="get" asp-controller="Workspace" asp-action="Index" class="d-flex flex-column flex-sm-row gap-2" style="min-width:min(100%,520px)">
                        <label class="visually-hidden" for="scopeIndex">Workspace assignment</label>
                        <select class="form-select" id="scopeIndex" name="scopeIndex" required>
                            @for (var i = 0; i < Model.Scopes.Count; i++)
                            {
                                var scope = Model.Scopes[i];
                                var label = $"{scope.ScopeLabel} — {scope.RoleName}";
                                if (Model.SelectedScope == scope)
                                {
                                    <option value="@i" selected>@label</option>
                                }
                                else
                                {
                                    <option value="@i">@label</option>
                                }
                            }
                        </select>
                        <button class="btn btn-primary text-nowrap" type="submit">Open workspace</button>
                    </form>
                </div>
            </div>
        </div>

        @if (Model.SelectedScope is not null)
        {
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100"><div class="card-body">
                        <div class="text-secondary small mb-2">ACTIVE TENANT</div>
                        <h3 class="h5 mb-1">@Model.SelectedScope.TenantName</h3>
                        <div class="small text-secondary">@Model.SelectedScope.TenantCode</div>
                    </div></div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100"><div class="card-body">
                        <div class="text-secondary small mb-2">BRANCH</div>
                        <h3 class="h5 mb-1">@(Model.SelectedScope.BranchName ?? "All assigned branches")</h3>
                        <div class="small text-secondary">@(Model.SelectedScope.BranchCode ?? "Tenant-level scope")</div>
                    </div></div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100"><div class="card-body">
                        <div class="text-secondary small mb-2">PROJECT</div>
                        <h3 class="h5 mb-1">@(Model.SelectedScope.ProjectName ?? "All assigned projects")</h3>
                        <div class="small text-secondary">@(Model.SelectedScope.ProjectCode ?? "No single project selected")</div>
                    </div></div>
                </div>
            </div>
        }

        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
            <div>
                <h2 class="h5 mb-1">Available modules</h2>
                <p class="text-secondary small mb-0">Modules are displayed only when the current login has the corresponding permission.</p>
            </div>
        </div>
        <div class="row g-3">
            @if (Model.Permissions.Contains("Platform.Dashboard.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">▦</div><h3 class="h6">Dashboard</h3><p class="text-secondary small mb-0">Your landing page and workspace overview.</p>
                </div></div></div>
            }
            @if (Model.Permissions.Contains("Tenant.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">▣</div><h3 class="h6">Organization</h3><p class="text-secondary small mb-0">Tenant information within your assigned scope.</p>
                </div></div></div>
            }
            @if (Model.Permissions.Contains("Branch.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">⌘</div><h3 class="h6">Branches</h3><p class="text-secondary small mb-0">Branch features allowed by your permissions.</p>
                </div></div></div>
            }
            @if (Model.Permissions.Contains("Project.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">◈</div><h3 class="h6">Projects</h3><p class="text-secondary small mb-0">Projects assigned to your account.</p>
                </div></div></div>
            }
            @if (Model.Permissions.Contains("User.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">♙</div><h3 class="h6">Users</h3><p class="text-secondary small mb-0">User administration permitted within your scope.</p>
                </div></div></div>
            }
            @if (Model.Permissions.Contains("Role.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">⚿</div><h3 class="h6">Roles &amp; access</h3><p class="text-secondary small mb-0">Role features allowed for your account.</p>
                </div></div></div>
            }
            @if (!Model.Permissions.Any(x => x is "Platform.Dashboard.View" or "Tenant.View" or "Branch.View" or "Project.View" or "User.View" or "Role.View"))
            {
                <div class="col-12"><div class="alert alert-info border-0">Your account has no workspace module permissions yet. Ask your administrator to review your role permissions.</div></div>
            }
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <span class="small text-secondary">PlatformHub · Secure workspace</span>
        <form method="post" asp-controller="Account" asp-action="Logout">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-secondary btn-sm" type="submit">Sign out</button>
        </form>
    </div>
</div>
