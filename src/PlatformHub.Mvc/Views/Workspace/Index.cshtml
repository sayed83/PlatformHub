@model PlatformHub.Mvc.Models.WorkspaceViewModel
@{
    ViewData["Title"] = "Workspace";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var scopeKey = Context.Request.Query["scopeKey"].ToString();
    string MenuIcon(string? icon) => (icon ?? string.Empty).Trim().ToLowerInvariant() switch
    {
        "layout-dashboard" or "dashboard" => "▦",
        "building-2" or "building" => "▣",
        "git-branch" or "branches" => "⑂",
        "panels-top-left" or "project" => "◈",
        "users" or "user" => "♙",
        "shield-check" or "shield" => "⚿",
        "key-round" or "key" => "⚷",
        "package" or "inventory" => "▤",
        "settings" or "settings-2" => "⚙",
        "book-open" or "book" => "▤",
        "graduation-cap" => "♧",
        _ => "•"
    };
}
<style>
    .ws-page { width:100%; min-width:0; max-width:100%; overflow-wrap:anywhere; }
    .ws-hero { position:relative; overflow:hidden; background:linear-gradient(118deg,#162538 0%,#203b59 58%,#28507a 100%); color:#fff; border-radius:1.1rem; }
    .ws-hero:after { content:""; position:absolute; width:260px;height:260px;border-radius:50%;right:-90px;top:-130px;background:rgba(255,255,255,.055);pointer-events:none; }
    .ws-eyebrow { color:#bfd6fb;letter-spacing:.13em;font-size:.72rem;font-weight:750;text-transform:uppercase; }
    .ws-hero h1 { font-size:clamp(1.65rem,2.2vw,2.45rem);line-height:1.2;overflow-wrap:anywhere; }
    .ws-identity { min-width:170px; padding:1rem 1.15rem; border:1px solid rgba(255,255,255,.16);border-radius:.9rem;background:rgba(255,255,255,.06); }
    .ws-section-title { font-size:1.05rem;font-weight:700;color:#192a3d; }
    .ws-scope-card { border:1px solid #e3e9f1!important;border-radius:1rem; }
    .ws-scope-form { display:flex;align-items:center;gap:.65rem;width:100%;min-width:0;max-width:100%; }
    .ws-scope-form .form-select { flex:1 1 0%;width:100%;min-width:0;max-width:100%;height:46px;border-color:#d4deea; }
    .ws-scope-form .btn { flex:0 1 220px;min-width:170px;max-width:100%;min-height:46px;white-space:normal;overflow-wrap:anywhere; }
    .ws-stat-card { height:100%;border:1px solid #e4eaf2!important;border-radius:1rem; }
    .ws-stat-label { color:#7b8796;font-size:.72rem;font-weight:750;letter-spacing:.08em;text-transform:uppercase; }
    .ws-stat-value { color:#1e2f43;font-size:clamp(1rem,1.3vw,1.22rem);font-weight:700;overflow-wrap:anywhere; }
    .ws-stat-icon,.ws-icon { width:42px;height:42px;flex:0 0 42px;border-radius:12px;display:flex;align-items:center;justify-content:center;background:#eaf1ff;color:#245fd1;font-size:1.15rem;font-weight:700; }
    .ws-card { transition:transform .15s ease,box-shadow .15s ease;height:100%;border:1px solid #e4eaf2!important;border-radius:1rem; }
    .ws-card:hover { transform:translateY(-2px);box-shadow:0 .55rem 1.3rem rgba(20,35,55,.09);border-color:#c8d9f5!important; }
    .ws-page .alert { overflow-wrap:anywhere; }
    @@media(max-width: 991.98px) {
        .ws-scope-form { align-items:stretch; }
        .ws-scope-form .btn { max-width:42%; }
    }
    @@media(max-width: 575.98px) {
        .ws-hero { border-radius:.85rem; }
        .ws-hero-body { padding:1.35rem!important; }
        .ws-identity { width:100%; }
        .ws-scope-form { flex-direction:column; }
        .ws-scope-form .form-select,.ws-scope-form .btn { width:100%;max-width:100%;flex:1 1 auto; }
    }
</style>
<div class="ws-page">
    <div class="ws-hero mb-4 shadow-sm">
        <div class="ws-hero-body p-4 p-lg-5">
        <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-center">
            <div>
                <div class="small text-uppercase fw-semibold mb-2" style="letter-spacing:.12em;color:#b9d0f6">PlatformHub · User Workspace</div>
                <h1 class="display-6 fw-semibold mb-2">Welcome, @Model.DisplayName</h1>
                <p class="mb-0 text-white-50">Your workspace is based on your assigned roles and access scope.</p>
            </div>
            <div class="text-lg-end">
                <div class="small text-white-50">Signed in as</div>
                <div class="fw-semibold">@Model.UserName</div>
                <div class="d-flex flex-wrap gap-1 mt-2 justify-content-lg-end">
                    @foreach (var role in Model.Roles)
                    {
                        <span class="badge rounded-pill text-bg-light">@role</span>
                    }
                </div>
            </div>
        </div>
        </div>
    </div>

    @if (!ViewData.ModelState.IsValid)
    {
        <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    }

    @if (Model.Scopes.Count == 0)
    {
        <div class="alert alert-warning border-0 shadow-sm">
            <h2 class="h5">No workspace assigned yet</h2>
            <p class="mb-2">Your account is active, but it has no valid active tenant, branch, or project assignment.</p>
            <p class="mb-0">Ask a Platform Admin to assign a role with the correct scope, then sign out and sign in again.</p>
        </div>
    }
    else
    {
        <div class="card ws-scope-card border-0 shadow-sm mb-4">
            <div class="card-body p-3 p-lg-4">
                <div class="row align-items-center g-3">
                    <div class="col-12 col-xl-4">
                        <div class="d-flex align-items-center gap-3">
                            <div class="ws-stat-icon" aria-hidden="true">⌂</div>
                            <div>
                                <h2 class="ws-section-title mb-1">Choose your workspace</h2>
                                <p class="text-secondary mb-0 small">Select the tenant, branch and project you want to work in.</p>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-xl-8">
                        <form method="post" asp-controller="Workspace" asp-action="Activate" class="ws-scope-form">
                            @Html.AntiForgeryToken()
                            <label class="visually-hidden" for="scopeKey">Workspace assignment</label>
                            <select class="form-select" id="scopeKey" name="scopeKey" required>
                                @for (var i = 0; i < Model.Scopes.Count; i++)
                                {
                                    var scope = Model.Scopes[i];
                                    var label = $"{scope.ScopeLabel} — {scope.RoleName}";
                                    if (Model.SelectedScope?.Key == scope.Key)
                                    {
                                        <option value="@scope.Key" selected>@label</option>
                                    }
                                    else
                                    {
                                        <option value="@scope.Key">@label</option>
                                    }
                                }
                            </select>
                            <button class="btn btn-primary" type="submit">Set active workspace</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @if (Model.SelectedScope is not null)
        {
            <div class="row g-3 mb-4">
                <div class="col-12 col-md-4">
                    <div class="card ws-stat-card shadow-sm"><div class="card-body p-3 p-lg-4">
                        <div class="ws-stat-label mb-2">Active tenant</div>
                        <h3 class="ws-stat-value mb-1">@Model.SelectedScope.TenantName</h3>
                        <div class="small text-secondary">@Model.SelectedScope.TenantCode</div>
                    </div></div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100"><div class="card-body">
                        <div class="ws-stat-label mb-2">Branch</div>
                        <h3 class="ws-stat-value mb-1">@(Model.SelectedScope.BranchName ?? "All assigned branches")</h3>
                        <div class="small text-secondary">@(Model.SelectedScope.BranchCode ?? "Tenant-level scope")</div>
                    </div></div>
                </div>
                <div class="col-md-4">
                    <div class="card border-0 shadow-sm h-100"><div class="card-body">
                        <div class="ws-stat-label mb-2">Project</div>
                        <h3 class="ws-stat-value mb-1">@(Model.SelectedScope.ProjectName ?? "All assigned projects")</h3>
                        <div class="small text-secondary">@(Model.SelectedScope.ProjectCode ?? "No single project selected")</div>
                    </div></div>
                </div>
            </div>
        }

        @if (Model.SelectedScope?.ProjectId is > 0)
        {
            <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
                <div>
                    <h2 class="h5 mb-1">Project navigation</h2>
                    <p class="text-secondary small mb-0">Menus below reflect your role permissions and personal menu overrides.</p>
                </div>
            </div>
            @if (Model.Menus.Count == 0)
            {
                <div class="alert alert-info border-0 shadow-sm">No project menus are currently allowed for this account. Ask your administrator to configure menu access.</div>
            }
            else
            {
                <div class="row g-3 mb-4">
                    @foreach (var menu in Model.Menus)
                    {
                        var href = menu.IsExternal
                            ? (Uri.TryCreate(menu.RouteUrl, UriKind.Absolute, out var externalUri) &&
                               (externalUri.Scheme == Uri.UriSchemeHttp || externalUri.Scheme == Uri.UriSchemeHttps)
                                ? menu.RouteUrl : null)
                            : (!string.IsNullOrWhiteSpace(menu.RouteUrl) && Url.IsLocalUrl(menu.RouteUrl)
                                ? menu.RouteUrl
                                : (!string.IsNullOrWhiteSpace(menu.Controller)
                                    ? Url.Action(menu.Action ?? "Index", menu.Controller, new { area = menu.Area })
                                    : null));
                        if (!string.IsNullOrWhiteSpace(href))
                        {
                            <div class="col-sm-6 col-xl-4">
                                <a href="@href" class="card ws-card border-0 shadow-sm text-decoration-none text-reset h-100"
                                   target="@(menu.IsExternal ? "_blank" : null)"
                                   rel="@(menu.IsExternal ? "noopener noreferrer" : null)"
                                   style="@(menu.ParentMenuId.HasValue ? "margin-left:1rem;" : null)">
                                    <div class="card-body p-4">
                                        <div class="ws-icon mb-3">@MenuIcon(menu.Icon)</div>
                                        <h3 class="h6">@menu.Name</h3>
                                        @if (!string.IsNullOrWhiteSpace(menu.ModuleName))
                                        {
                                            <p class="text-secondary small mb-0">@menu.ModuleName</p>
                                        }
                                    </div>
                                </a>
                            </div>
                        }
                    }
                </div>
            }
        }
        @if (Model.Menus.Count == 0)
        {
        <div class="d-flex flex-wrap justify-content-between align-items-end gap-2 mb-3">
            <div>
                <h2 class="h5 mb-1">Available modules</h2>
                <p class="text-secondary small mb-0">Modules are displayed only when the current login has the corresponding permission.</p>
            </div>
        </div>
        <div class="row g-3">
            @if (Model.Permissions.Contains("Platform.Dashboard.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">▦</div><h3 class="h6">Dashboard</h3><p class="text-secondary small mb-0">Your landing page and workspace overview.</p>
                </div></div></div>
            }
            @if (Model.Permissions.Contains("Tenant.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">▣</div><h3 class="h6">Organization</h3><p class="text-secondary small mb-0">Tenant information within your assigned scope.</p>
                </div></div></div>
            }
            @if (Model.Permissions.Contains("Branch.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">⌘</div><h3 class="h6">Branches</h3><p class="text-secondary small mb-0">Branch features allowed by your permissions.</p>
                </div></div></div>
            }
            @if (Model.Permissions.Contains("Project.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">◈</div><h3 class="h6">Projects</h3><p class="text-secondary small mb-0">Projects assigned to your account.</p>
                </div></div></div>
            }
            @if (Model.Permissions.Contains("User.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">♙</div><h3 class="h6">Users</h3><p class="text-secondary small mb-0">User administration permitted within your scope.</p>
                </div></div></div>
            }
            @if (Model.Permissions.Contains("Role.View"))
            {
                <div class="col-sm-6 col-xl-4"><div class="card ws-card border-0 shadow-sm"><div class="card-body p-4">
                    <div class="ws-icon mb-3">⚿</div><h3 class="h6">Roles &amp; access</h3><p class="text-secondary small mb-0">Role features allowed for your account.</p>
                </div></div></div>
            }
            @if (!Model.Permissions.Any(x => x is "Platform.Dashboard.View" or "Tenant.View" or "Branch.View" or "Project.View" or "User.View" or "Role.View"))
            {
                <div class="col-12"><div class="alert alert-info border-0">Your account has no workspace module permissions yet. Ask your administrator to review your role permissions.</div></div>
            }
        </div>
        }
    }

    <div class="d-flex justify-content-between align-items-center mt-4 pt-3 border-top">
        <span class="small text-secondary">PlatformHub · Secure workspace</span>
        <form method="post" asp-controller="Account" asp-action="Logout">
            @Html.AntiForgeryToken()
            <button class="btn btn-outline-secondary btn-sm" type="submit">Sign out</button>
        </form>
    </div>
</div>
