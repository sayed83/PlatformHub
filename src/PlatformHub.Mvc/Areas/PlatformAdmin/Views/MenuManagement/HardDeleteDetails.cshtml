@using System.Text.Json
@model JsonElement
@{
    ViewData["Title"] = "Hard delete details";
    var itemType = (string)(ViewData["ItemType"] ?? "menu");
    var itemId = (long)(ViewData["ItemId"] ?? 0L);
    var projectId = (long)(ViewData["ProjectId"] ?? 0L);
    var returnUrl = (string?)(ViewData["ReturnUrl"]);
    var item = Model.GetProperty(itemType == "module" ? "module" : "menu");
    var canDelete = Model.TryGetProperty("canHardDelete", out var allowed) && allowed.ValueKind == JsonValueKind.True;
    string Val(JsonElement e, string key, string fallback = "—") => e.TryGetProperty(key, out var v) && v.ValueKind != JsonValueKind.Null ? v.ToString() : fallback;
}
<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <div><div class="text-uppercase small fw-bold text-secondary mb-2">Platform Admin · Project Navigation</div><h1 class="h3">Hard delete confirmation</h1><p class="text-secondary">Review related records before permanently deleting this @(itemType == "module" ? "module" : "menu entry").</p></div>
        <a class="btn btn-outline-secondary" href="@returnUrl">← Back without deleting</a>
    </div>
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger">@error</div> }
    <div class="card border-0 shadow-sm mb-4"><div class="card-body">
        <h2 class="h5">@Val(item, "name")</h2><div class="text-secondary small">Code: <code>@Val(item, "code")</code> · ID: @itemId · Project ID: @projectId</div>
        @if (itemType == "menu") { <div class="mt-2 small">Module: @Val(item, "moduleName", "Standalone") · Parent: @Val(item, "parentMenuName")</div><div class="small">Route: @Val(item, "routeUrl")</div> }
        <div class="mt-2">Status: @Val(item, "isActive")</div>
    </div></div>
    @if (itemType == "module")
    {
        var records = Model.GetProperty("relatedMenus");
        <div class="card border-0 shadow-sm mb-4"><div class="card-header bg-white fw-semibold">Related menu entries (@records.GetArrayLength())</div>
        @if (records.GetArrayLength() == 0) { <div class="card-body text-secondary">No menu entries reference this module.</div> }
        else { <div class="table-responsive"><table class="table table-sm align-middle mb-0"><thead><tr><th>Menu</th><th>Code</th><th>Status</th><th>Role access</th><th>User access</th><th>Child menus</th></tr></thead><tbody>
        @foreach (var row in records.EnumerateArray()) { <tr><td>@Val(row,"name")</td><td><code>@Val(row,"code")</code></td><td>@Val(row,"isActive")</td><td>@Val(row,"roleAccessCount","0")</td><td>@Val(row,"userAccessCount","0")</td><td>@Val(row,"childMenuCount","0")</td></tr> }
        </tbody></table></div> }</div>
    }
    else
    {
        @foreach (var group in new[] { ("Child menus", "childMenus"), ("Role-wise access records", "roleAccess"), ("User-wise access records", "userAccess") })
        {
            var records = Model.GetProperty(group.Item2);
            <div class="card border-0 shadow-sm mb-3"><div class="card-header bg-white fw-semibold">@group.Item1 (@records.GetArrayLength())</div>
            @if (records.GetArrayLength() == 0) { <div class="card-body text-secondary">No related records.</div> }
            else { <div class="table-responsive"><table class="table table-sm mb-0"><thead><tr>@foreach (var p in records[0].EnumerateObject().Where(p => p.Name != "id")) { <th>@System.Text.RegularExpressions.Regex.Replace(p.Name, "([a-z])([A-Z])", "$1 $2")</th> }</tr></thead><tbody>
            @foreach (var row in records.EnumerateArray()) { <tr>@foreach (var p in row.EnumerateObject().Where(p => p.Name != "id")) { <td>@(p.Value.ValueKind == JsonValueKind.Null ? "—" : p.Value.ToString())</td> }</tr> }
            </tbody></table></div> }</div>
        }
    }
    @if (!canDelete) { <div class="alert alert-warning"><strong>Hard delete is blocked.</strong> @Val(Model, "reason", "Related records must be resolved first.") Soft delete remains available to preserve history.</div> }
    else { <div class="alert alert-danger"><strong>This action is permanent.</strong> The record cannot be restored after deletion.</div> }
    <div class="d-flex gap-2 flex-wrap"><a class="btn btn-outline-secondary" href="@returnUrl">Cancel and return</a>
    @if (canDelete) {
        <form method="post" action="@Url.Action("ConfirmHardDelete", "MenuManagement", new { area = "PlatformAdmin" })" onsubmit="return confirm('Permanently delete this record? This cannot be undone.');">
            @Html.AntiForgeryToken()<input type="hidden" name="itemType" value="@itemType" /><input type="hidden" name="itemId" value="@itemId" /><input type="hidden" name="projectId" value="@projectId" /><input type="hidden" name="returnUrl" value="@returnUrl" />
            <button class="btn btn-danger" type="submit">Permanently delete</button>
        </form>
    }</div>
</div>