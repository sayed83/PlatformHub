@using PlatformHub.Mvc.Areas.PlatformAdmin.Models
@model TenantProjectAssignmentViewModel
@{
    ViewData["Title"] = "Tenant project assignments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .tpa-toolbar { display:flex; flex-wrap:wrap; gap:.75rem; align-items:center; justify-content:space-between; }
    .tpa-search { max-width:28rem; }
    .tpa-project-list { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%, 19rem),1fr)); gap:.75rem; }
    .tpa-project { position:relative; display:flex; align-items:flex-start; gap:.8rem; padding:1rem; border:1px solid var(--bs-border-color); border-radius:.8rem; background:var(--bs-body-bg); cursor:pointer; min-width:0; transition:border-color .15s, background-color .15s, box-shadow .15s; }
    .tpa-project:hover { border-color:var(--bs-primary); }
    .tpa-project:has(input:checked) { border-color:var(--bs-primary); background:rgba(13,110,253,.055); box-shadow:inset 0 0 0 1px var(--bs-primary); }
    .tpa-project input { flex:0 0 auto; width:1.1rem; height:1.1rem; margin-top:.15rem; }
    .tpa-project-details { min-width:0; flex:1; }
    .tpa-project-name { overflow-wrap:anywhere; font-weight:650; }
    .tpa-project-code { font-size:.8rem; color:var(--bs-secondary-color); }
    .tpa-project-url { display:block; margin-top:.35rem; color:var(--bs-secondary-color); font-size:.78rem; overflow-wrap:anywhere; }
    .tpa-empty { border:1px dashed var(--bs-border-color); border-radius:.75rem; padding:2rem 1rem; text-align:center; color:var(--bs-secondary-color); }
</style>
<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <a asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index" class="small text-decoration-none">← Tenant management</a>
            <h1 class="h3 fw-bold mt-2 mb-1">Project assignments</h1>
            <p class="text-secondary mb-0">Choose which existing applications <strong>@Model.TenantName</strong> (@Model.TenantCode) can access. Projects are shared catalogue entries; they are not recreated for each tenant.</p>
        </div>
        <span class="badge rounded-pill text-bg-primary">@Model.Projects.Count(p => p.IsActive) active catalogue projects</span>
    </div>

    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success alert-dismissible fade show" role="status">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }

    <section class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-body p-3 p-lg-4 border-bottom">
            <h2 class="h5 fw-bold mb-1">Available applications</h2>
            <p class="small text-secondary mb-0">Search the catalogue and tick each project this tenant should be allowed to use.</p>
        </div>
        <form asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="AssignProjects" method="post" id="tenantProjectsForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.TenantId" />
            <div class="card-body p-3 p-lg-4">
                @if (!Model.Projects.Any(p => p.IsActive))
                {
                    <div class="alert alert-info mb-0">
                        No active projects are in the catalogue yet. <a asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Index" class="alert-link">Create a reusable project definition</a> first, then return here to assign it.
                    </div>
                }
                else
                {
                    <div class="tpa-toolbar mb-3">
                        <div class="tpa-search w-100">
                            <label for="projectSearch" class="form-label small fw-semibold mb-1">Search projects</label>
                            <input type="search" id="projectSearch" class="form-control" placeholder="Search by project name or code…" autocomplete="off" />
                        </div>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="small text-secondary" id="assignmentCount" aria-live="polite">0 selected</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="selectVisibleProjects">Select visible</button>
                            <button type="button" class="btn btn-sm btn-outline-secondary" id="clearVisibleProjects">Clear visible</button>
                        </div>
                    </div>
                    <div class="tpa-project-list" id="projectOptions">
                        @foreach (var project in Model.Projects.Where(p => p.IsActive).OrderBy(p => p.Name))
                        {
                            var isSelected = Model.SelectedProjectIds.Contains(project.Id);
                            <label class="tpa-project" data-project-search="@($"{project.Code} {project.Name}".ToLowerInvariant())">
                                <input type="checkbox" name="projectIds" value="@project.Id" checked="@isSelected" />
                                <span class="tpa-project-details">
                                    <span class="tpa-project-name d-block">@project.Name</span>
                                    <span class="tpa-project-code"><code>@project.Code</code> · Project ID: @project.Id</span>
                                    @if (!string.IsNullOrWhiteSpace(project.BaseUrl))
                                    {
                                        <span class="tpa-project-url">@project.BaseUrl</span>
                                    }
                                </span>
                            </label>
                        }
                    </div>
                    <div class="tpa-empty mt-3 d-none" id="noProjectsMatch">No projects match your search. Try another name or code.</div>
                    <div class="alert alert-light border mt-3 mb-0">
                        <strong>Important:</strong> Clearing a checkbox revokes this tenant's project assignment. Review user and branch access before removing an application.
                    </div>
                }
            </div>
            <div class="card-footer bg-body d-flex flex-wrap justify-content-between align-items-center gap-2 p-3">
                <a asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                @if (Model.Projects.Any(p => p.IsActive))
                {
                    <button type="submit" class="btn btn-primary">Save project assignments</button>
                }
            </div>
        </form>
    </section>
</div>
@section Scripts {
<script>
(function () {
    const form = document.getElementById('tenantProjectsForm');
    const search = document.getElementById('projectSearch');
    const list = document.getElementById('projectOptions');
    const count = document.getElementById('assignmentCount');
    if (!form || !list || !count) return;

    const cards = Array.from(list.querySelectorAll('[data-project-search]'));
    const boxes = cards.map(card => card.querySelector('input[name="projectIds"]')).filter(Boolean);
    const noMatch = document.getElementById('noProjectsMatch');

    function updateCount() {
        const selected = boxes.filter(box => box.checked).length;
        count.textContent = selected + (selected === 1 ? ' project selected' : ' projects selected');
    }

    function filterProjects() {
        const term = (search?.value || '').trim().toLowerCase();
        let visible = 0;
        cards.forEach(card => {
            const matches = !term || (card.dataset.projectSearch || '').includes(term);
            card.classList.toggle('d-none', !matches);
            if (matches) visible++;
        });
        noMatch?.classList.toggle('d-none', visible !== 0);
    }

    search?.addEventListener('input', filterProjects);
    boxes.forEach(box => box.addEventListener('change', updateCount));

    document.getElementById('selectVisibleProjects')?.addEventListener('click', function () {
        cards.forEach(card => {
            if (!card.classList.contains('d-none')) {
                const box = card.querySelector('input[name="projectIds"]');
                if (box) box.checked = true;
            }
        });
        updateCount();
    });

    document.getElementById('clearVisibleProjects')?.addEventListener('click', function () {
        cards.forEach(card => {
            if (!card.classList.contains('d-none')) {
                const box = card.querySelector('input[name="projectIds"]');
                if (box) box.checked = false;
            }
        });
        updateCount();
    });

    updateCount();
    filterProjects();
})();
</script>
}
