@using PlatformHub.Mvc.Areas.PlatformAdmin.Models
@model TenantProjectAssignmentViewModel
@{
    ViewData["Title"] = "Tenant project assignments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="container-fluid py-3">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
        <div>
            <a asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index" class="small text-decoration-none">← Tenant management</a>
            <h1 class="h3 fw-bold mt-2 mb-1">Project assignments</h1>
            <p class="text-secondary mb-0">Assign existing application projects to <strong>@Model.TenantName</strong> (@Model.TenantCode). You do not need to create a new project for every tenant.</p>
        </div>
        <span class="badge rounded-pill text-bg-primary">@Model.Projects.Count(p => p.IsActive) active catalogue projects</span>
    </div>

    @if (TempData["SuccessMessage"] is string success) { <div class="alert alert-success alert-dismissible fade show" role="status">@success<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
    @if (TempData["ErrorMessage"] is string error) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@error<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-header bg-body p-4 border-bottom">
            <h2 class="h5 fw-bold mb-1">Available applications</h2>
            <p class="small text-secondary mb-0">Select every application this tenant can access. Existing project definitions are shared; assignment does not duplicate them.</p>
        </div>
        <form asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="AssignProjects" method="post" id="tenantProjectsForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" value="@Model.TenantId" />
            <div class="card-body p-4">
                @if (!Model.Projects.Any(p => p.IsActive))
                {
                    <div class="alert alert-info mb-0">
                        No active projects are in the catalogue yet. <a asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Index" class="alert-link">Create a reusable project definition</a> first, then return here to assign it.
                    </div>
                }
                else
                {
                    <label for="projectIds" class="form-label fw-semibold">Projects for @Model.TenantName</label>
                    <select id="projectIds" name="projectIds" class="form-select" multiple data-placeholder="Search and select projects">
                        @foreach (var project in Model.Projects.Where(p => p.IsActive).OrderBy(p => p.Name))
                        {
                            if (Model.SelectedProjectIds.Contains(project.Id))
                            {
                                <option value="@project.Id" selected>@project.Code — @project.Name</option>
                            }
                            else
                            {
                                <option value="@project.Id">@project.Code — @project.Name</option>
                            }
                        }
                    </select>
                    <div class="form-text mt-2">Use the search field to find School Management, Hospital Management, ComplexERP, or another existing project.</div>
                    <div class="alert alert-light border mt-3 mb-0">
                        <strong>Important:</strong> Removing a project here revokes the tenant's application assignment. Make sure users and branches that need this application are reassigned before removing it.
                    </div>
                }
            </div>
            <div class="card-footer bg-body d-flex flex-wrap justify-content-between gap-2 p-3">
                <a asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
                @if (Model.Projects.Any(p => p.IsActive))
                {
                    <button type="submit" class="btn btn-primary">Save project assignments</button>
                }
            </div>
        </form>
    </div>
</div>
@section Scripts {
<script>
    (function () {
        const element = document.getElementById('projectIds');
        if (!element) return;
        if (window.jQuery && jQuery.fn.select2) {
            jQuery(element).select2({
                theme: 'bootstrap-5',
                width: '100%',
                placeholder: element.dataset.placeholder,
                closeOnSelect: false
            });
        }
    })();
</script>
}
