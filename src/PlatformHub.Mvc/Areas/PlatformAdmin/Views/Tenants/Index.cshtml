@using PlatformHub.Mvc.Areas.PlatformAdmin.Models
@model TenantManagementViewModel
@{
    ViewData["Title"] = "Tenant Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var activeCount = Model.Tenants.Count(x => x.IsActive);
    var inactiveCount = Model.Tenants.Count - activeCount;
}
<style>
    .tm-stat { border:1px solid var(--bs-border-color); border-radius:.9rem; background:var(--bs-body-bg); padding:1rem; height:100%; }
    .tm-stat-label { color:var(--bs-secondary-color); font-size:.78rem; font-weight:600; letter-spacing:.04em; text-transform:uppercase; }
    .tm-stat-value { font-size:1.65rem; line-height:1.2; font-weight:700; margin-top:.45rem; }
    .tm-avatar { display:inline-flex; width:2.7rem; height:2.7rem; align-items:center; justify-content:center; flex:0 0 2.7rem; border-radius:.8rem; background:rgba(13,110,253,.12); color:var(--bs-primary); font-weight:700; }
    .tm-table th { white-space:nowrap; color:var(--bs-secondary-color); font-size:.75rem; text-transform:uppercase; letter-spacing:.04em; }
    .tm-table td { padding-top:1rem; padding-bottom:1rem; }
</style>

<div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <a asp-area="PlatformAdmin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none small"><span aria-hidden="true">←</span> Dashboard</a>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-2"><h1 class="h3 fw-bold mb-0">Tenant management</h1><span class="badge rounded-pill text-bg-light border text-dark">Platform administration</span></div>
            <p class="text-secondary mb-0 mt-1">Manage tenant organizations and navigate to their branch administration.</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTenantModal"><span aria-hidden="true" class="tm-symbol">＋</span> Create tenant</button>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success alert-dismissible fade show" role="status">@successMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
    @if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@errorMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
    @if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
}

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-4"><div class="tm-stat"><div class="d-flex justify-content-between"><span class="tm-stat-label">Tenants shown</span><span class="text-primary fs-5" aria-hidden="true">▦</span></div><div class="tm-stat-value">@Model.Tenants.Count</div><div class="small text-secondary mt-1">Organizations registered</div></div></div>
        <div class="col-6 col-xl-4"><div class="tm-stat"><div class="d-flex justify-content-between"><span class="tm-stat-label">Active</span><span class="text-success fs-5" aria-hidden="true">✓</span></div><div class="tm-stat-value">@activeCount</div><div class="small text-secondary mt-1">Enabled tenants</div></div></div>
        <div class="col-12 col-xl-4"><div class="tm-stat"><div class="d-flex justify-content-between"><span class="tm-stat-label">Inactive</span><span class="text-secondary fs-5" aria-hidden="true">Ⅱ</span></div><div class="tm-stat-value">@inactiveCount</div><div class="small text-secondary mt-1">Disabled tenants</div></div></div>
    </div>

    <section class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-body border-bottom p-3 p-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div><h2 class="h5 fw-bold mb-1">Tenant directory</h2><p class="small text-secondary mb-0">Review organization codes, status, and branch management.</p></div>
                <span class="small text-secondary">Showing @Model.Tenants.Count tenant(s)</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table tm-table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th class="ps-3 ps-lg-4">Tenant</th><th>Tenant code</th><th>Status</th><th class="text-end pe-3 pe-lg-4">Actions</th></tr></thead>
                <tbody>
                @if (Model.Tenants.Count == 0)
                {
                    <tr><td colspan="4" class="text-center py-5"><div class="text-secondary fs-1 mb-2" aria-hidden="true">▦</div><div class="fw-semibold">No tenants yet</div><div class="small text-secondary mb-3">Create a tenant to start organizing branches and projects.</div><button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createTenantModal">＋ Create tenant</button></td></tr>
                }
                else
                {
                    @foreach (var tenant in Model.Tenants)
                    {
                        <tr>
                            <td class="ps-3 ps-lg-4"><div class="d-flex align-items-center gap-3"><span class="tm-avatar">@((string.IsNullOrWhiteSpace(tenant.Name) ? tenant.Code : tenant.Name).Trim().Substring(0,1).ToUpperInvariant())</span><div class="min-w-0"><div class="fw-semibold">@tenant.Name</div><div class="small text-secondary">Tenant ID: @tenant.Id</div></div></div></td>
                            <td><code class="fw-semibold">@tenant.Code</code></td>
                            <td>@if (tenant.IsActive) { <span class="badge rounded-pill text-bg-success-subtle border border-success-subtle text-success-emphasis">✓ Active</span> } else { <span class="badge rounded-pill text-bg-secondary">Inactive</span> }</td>
                            <td class="text-end pe-3 pe-lg-4">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <a asp-area="PlatformAdmin" asp-controller="Branches" asp-action="Index" asp-route-tenantId="@tenant.Id" class="btn btn-sm btn-outline-primary">Branches</a>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editTenant-@tenant.Id">Edit</button>
                                    <form asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Deactivate this tenant? Its data will be retained.');">
                                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@tenant.Id" /><input type="hidden" name="hardDelete" value="false" />
                                        <button type="submit" class="btn btn-sm btn-outline-warning">Soft delete</button>
                                    </form>
                                    @if (Model.CanHardDeleteTenantIds.Contains(tenant.Id))
                                    {
                                        <form asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Permanently delete this tenant? This cannot be undone.');">
                                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@tenant.Id" /><input type="hidden" name="hardDelete" value="true" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Hard delete</button>
                                        </form>
                                    }
                                </div>
                                <div class="modal fade text-start" id="editTenant-@tenant.Id" tabindex="-1" aria-labelledby="editTenantTitle-@tenant.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                                        <form asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Edit" method="post">
                                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@tenant.Id" />
                                            <div class="modal-header"><h2 class="modal-title h5" id="editTenantTitle-@tenant.Id">Edit tenant</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                                            <div class="modal-body">
                                                <label class="form-label" for="tenantCode-@tenant.Id">Tenant code</label><input class="form-control mb-3" id="tenantCode-@tenant.Id" name="code" value="@tenant.Code" maxlength="50" required pattern="[A-Za-z0-9_-]+" />
                                                <label class="form-label" for="tenantName-@tenant.Id">Tenant name</label><input class="form-control" id="tenantName-@tenant.Id" name="name" value="@tenant.Name" maxlength="200" required />
                                            </div>
                                            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save changes</button></div>
                                        </form>
                                    </div></div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-body small text-secondary d-flex flex-wrap justify-content-between gap-2"><span>Tenant directory</span><span>Each project and branch must belong to a tenant.</span></div>
    </section>
</div>

<div class="modal fade" id="createTenantModal" tabindex="-1" aria-labelledby="createTenantTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content border-0 shadow rounded-4">
        <form asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div class="modal-header px-4 pt-4"><div><h2 class="modal-title h5 fw-bold" id="createTenantTitle">Create tenant</h2><p class="small text-secondary mb-0">Register a new tenant organization.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body px-4">
                <div class="mb-3"><label asp-for="Code" class="form-label fw-semibold">Tenant code</label><input asp-for="Code" class="form-control" placeholder="e.g. ACME" maxlength="50" autocomplete="off"/><div class="form-text">Letters, numbers, hyphens, and underscores. Saved in uppercase.</div><span asp-validation-for="Code" class="text-danger small"></span></div>
                <div class="mb-1"><label asp-for="Name" class="form-label fw-semibold">Tenant name</label><input asp-for="Name" class="form-control" placeholder="Organization name" maxlength="200"/><span asp-validation-for="Name" class="text-danger small"></span></div>
            </div>
            <div class="modal-footer px-4 pb-4"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary"><span aria-hidden="true">✓</span> Create tenant</button></div>
        </form>
    </div></div>
</div>
