@using PlatformHub.Mvc.Areas.PlatformAdmin.Models
@model TenantManagementViewModel
@{
    ViewData["Title"] = "Tenant directory";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var activeCount = Model.Tenants.Count(x => x.IsActive);
    var inactiveCount = Model.Tenants.Count - activeCount;
}
<style>
    .tv-hero { border:1px solid #dce6f3; border-radius:1rem; padding:clamp(1.25rem,3vw,2rem); background:linear-gradient(120deg,#eaf2ff,#f8fbff); }
    .tv-stat { height:100%; border:1px solid var(--bs-border-color); border-radius:.85rem; background:var(--bs-body-bg); padding:1rem; }
    .tv-stat-label { color:var(--bs-secondary-color); font-size:.76rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; }
    .tv-stat-value { font-size:1.7rem; font-weight:750; line-height:1.2; margin-top:.45rem; }
    .tv-avatar { display:inline-flex; align-items:center; justify-content:center; flex:0 0 2.65rem; width:2.65rem; height:2.65rem; border-radius:.8rem; color:var(--bs-primary); background:rgba(13,110,253,.1); font-weight:750; }
    .tv-table th { white-space:nowrap; color:var(--bs-secondary-color); font-size:.75rem; text-transform:uppercase; letter-spacing:.045em; }
    .tv-table td { padding-top:.9rem; padding-bottom:.9rem; }
</style>

<section class="tv-hero mb-4">
    <div class="d-flex align-items-start gap-3">
        <div class="tv-avatar" aria-hidden="true">▦</div>
        <div class="flex-grow-1">
            <div class="small text-primary fw-bold text-uppercase mb-2">Organization · Read only</div>
            <h1 class="h3 fw-bold mb-2">Tenant directory</h1>
            <p class="text-secondary mb-0">View tenant information available to your account. This page is read-only; tenant creation, editing, activation, deletion, and project assignment are managed by an authorized platform administrator.</p>
        </div>
        <span class="badge rounded-pill text-bg-light border text-secondary">Tenant.View</span>
    </div>
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-4"><div class="tv-stat"><div class="tv-stat-label">Tenants available</div><div class="tv-stat-value">@Model.Tenants.Count</div><div class="small text-secondary mt-1">Visible within your access scope</div></div></div>
    <div class="col-6 col-sm-4"><div class="tv-stat"><div class="tv-stat-label">Active</div><div class="tv-stat-value">@activeCount</div><div class="small text-secondary mt-1">Enabled tenants</div></div></div>
    <div class="col-6 col-sm-4"><div class="tv-stat"><div class="tv-stat-label">Inactive</div><div class="tv-stat-value">@inactiveCount</div><div class="small text-secondary mt-1">Disabled tenants</div></div></div>
</div>

<section class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-body p-3 p-lg-4">
        <h2 class="h5 fw-bold mb-1">Available tenants</h2>
        <p class="small text-secondary mb-0">Only tenant records returned for your account are displayed.</p>
    </div>
    <div class="p-3">
        <div id="tenantDirectoryGrid" class="ph-tabulator-grid"></div>
    </div>
    <script>
        (function () {
            function initTenantGrid() {
            const rows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tenants.Select(t => new { id = t.Id, name = t.Name, code = t.Code, status = t.IsActive ? "Active" : "Inactive" })));
            window.PlatformHubGrid.create({
                element: '#tenantDirectoryGrid',
                data: rows,
                placeholder: 'No tenants available in your current access scope.',
                columns: [
                    { title: 'Tenant', field: 'name', minWidth: 220, formatter: function (cell) {
                        const row = cell.getRow().getData();
                        return '<div class="fw-semibold">' + window.PlatformHubGrid.escape(row.name) + '</div><div class="small text-secondary">Tenant ID: ' + row.id + '</div>';
                    }},
                    { title: 'Tenant code', field: 'code', width: 180, formatter: function (cell) { return '<code>' + window.PlatformHubGrid.escape(cell.getValue()) + '</code>'; }},
                    { title: 'Status', field: 'status', width: 140, formatter: function (cell) {
                        const active = cell.getValue() === 'Active';
                        return '<span class="badge rounded-pill ' + (active ? 'text-bg-success' : 'text-bg-secondary') + '">' + window.PlatformHubGrid.escape(cell.getValue()) + '</span>';
                    }}
                ]
            });
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initTenantGrid, { once: true });
            else initTenantGrid();
        })();
    </script>
</section>
