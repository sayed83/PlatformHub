@using PlatformHub.Mvc.Areas.PlatformAdmin.Models
@model TenantManagementViewModel
@{
    ViewData["Title"] = "Tenant directory";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var activeCount = Model.Tenants.Count(x => x.IsActive);
    var inactiveCount = Model.Tenants.Count - activeCount;
    var canCreate = User.HasClaim("ph_permission", "Tenant.Create");
    var canUpdate = User.HasClaim("ph_permission", "Tenant.Update");
    var canDeactivate = User.HasClaim("ph_permission", "Tenant.Deactivate");
    var canManage = canCreate || canUpdate || canDeactivate;
}
<style>
    .tv-hero { border:1px solid #dce6f3; border-radius:1rem; padding:clamp(1.25rem,3vw,2rem); background:linear-gradient(120deg,#eaf2ff,#f8fbff); }
    .tv-stat { height:100%; border:1px solid var(--bs-border-color); border-radius:.85rem; background:var(--bs-body-bg); padding:1rem; }
    .tv-stat-label { color:var(--bs-secondary-color); font-size:.76rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; }
    .tv-stat-value { font-size:1.7rem; font-weight:750; line-height:1.2; margin-top:.45rem; }
    .tv-avatar { display:inline-flex; align-items:center; justify-content:center; flex:0 0 2.65rem; width:2.65rem; height:2.65rem; border-radius:.8rem; color:var(--bs-primary); background:rgba(13,110,253,.1); font-weight:750; }
    .tv-table th { white-space:nowrap; color:var(--bs-secondary-color); font-size:.75rem; text-transform:uppercase; letter-spacing:.045em; }
    .tv-table td { padding-top:.9rem; padding-bottom:.9rem; }
    .tv-actions { display:flex; flex-wrap:wrap; gap:.35rem; align-items:center; }
    .tv-actions .btn { white-space:nowrap; }
    .tv-hero-actions { display:flex; justify-content:flex-end; margin-top:1rem; }
    @media(min-width:768px){.tv-hero-actions{margin-top:0;}}
</style>

<section class="tv-hero mb-4">
    <div class="d-flex flex-wrap align-items-start gap-3">
        <div class="tv-avatar" aria-hidden="true">▦</div>
        <div class="flex-grow-1">
            <div class="small text-primary fw-bold text-uppercase mb-2">Organization · Permission-based access</div>
            <h1 class="h3 fw-bold mb-2">Tenant directory</h1>
            <p class="text-secondary mb-0">View tenant information available to your account. Available actions are shown according to your assigned permissions.</p>
        </div>
        <span class="badge rounded-pill text-bg-light border text-secondary">Tenant.View</span>
    </div>
    @if (canCreate)
    {
        <div class="tv-hero-actions">
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createTenantModal">
                <span aria-hidden="true">＋</span> Create tenant
            </button>
        </div>
    }
</section>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success" role="status">@successMessage</div>
}
@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger" role="alert">@errorMessage</div>
}

<div class="row g-3 mb-4">
    <div class="col-12 col-sm-4"><div class="tv-stat"><div class="tv-stat-label">Tenants available</div><div class="tv-stat-value">@Model.Tenants.Count</div><div class="small text-secondary mt-1">Visible within your access scope</div></div></div>
    <div class="col-6 col-sm-4"><div class="tv-stat"><div class="tv-stat-label">Active</div><div class="tv-stat-value">@activeCount</div><div class="small text-secondary mt-1">Enabled tenants</div></div></div>
    <div class="col-6 col-sm-4"><div class="tv-stat"><div class="tv-stat-label">Inactive</div><div class="tv-stat-value">@inactiveCount</div><div class="small text-secondary mt-1">Disabled tenants</div></div></div>
</div>

<section class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-body p-3 p-lg-4">
        <h2 class="h5 fw-bold mb-1">Available tenants</h2>
        <p class="small text-secondary mb-0">Only tenant records returned for your account are displayed.</p>
    </div>
    <div class="p-3">
        <div id="tenantDirectoryGrid" class="ph-tabulator-grid"></div>
        @Html.AntiForgeryToken()
        @if (canUpdate)
        {
            @foreach (var tenant in Model.Tenants)
            {
                <div class="modal fade" id="editTenant-@tenant.Id" tabindex="-1" aria-labelledby="editTenantTitle-@tenant.Id" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                        <form asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Edit" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@tenant.Id" />
                            <div class="modal-header"><h2 class="modal-title h5" id="editTenantTitle-@tenant.Id">Edit tenant</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                            <div class="modal-body">
                                <label class="form-label" for="tenantCode-@tenant.Id">Tenant code</label>
                                <input class="form-control mb-3" id="tenantCode-@tenant.Id" name="code" value="@tenant.Code" maxlength="50" required pattern="[A-Za-z0-9_-]+" />
                                <label class="form-label" for="tenantName-@tenant.Id">Tenant name</label>
                                <input class="form-control" id="tenantName-@tenant.Id" name="name" value="@tenant.Name" maxlength="200" required />
                            </div>
                            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save changes</button></div>
                        </form>
                    </div></div>
                </div>
            }
        }
        @if (canCreate)
        {
            <div class="modal fade" id="createTenantModal" tabindex="-1" aria-labelledby="createTenantTitle" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                    <form asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div class="modal-header"><h2 class="modal-title h5" id="createTenantTitle">Create tenant</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                        <div class="modal-body">
                            <label class="form-label" for="newTenantCode">Tenant code</label><input class="form-control mb-3" id="newTenantCode" name="Code" maxlength="50" required pattern="[A-Za-z0-9_-]+" />
                            <label class="form-label" for="newTenantName">Tenant name</label><input class="form-control" id="newTenantName" name="Name" maxlength="200" required />
                        </div>
                        <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Create tenant</button></div>
                    </form>
                </div></div>
            </div>
        }
    </div>
    <script>
        (function () {
            function initTenantGrid() {
            const rows = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Tenants.Select(t => new { id = t.Id, name = t.Name, code = t.Code, isActive = t.IsActive, status = t.IsActive ? "Active" : "Inactive" })));
            const canUpdate = @canUpdate.ToString().ToLowerInvariant();
            const canDeactivate = @canDeactivate.ToString().ToLowerInvariant();
            const token = document.querySelector('#tenantDirectoryGrid').parentElement.querySelector('input[name="__RequestVerificationToken"]')?.value
                || document.querySelector('input[name="__RequestVerificationToken"]')?.value
                || '';
            window.PlatformHubGrid.create({
                element: '#tenantDirectoryGrid',
                data: rows,
                placeholder: 'No tenants available in your current access scope.',
                columns: [
                    { title: 'Tenant', field: 'name', minWidth: 220, formatter: function (cell) {
                        const row = cell.getRow().getData();
                        return '<div class="fw-semibold">' + window.PlatformHubGrid.escape(row.name) + '</div><div class="small text-secondary">Tenant ID: ' + row.id + '</div>';
                    }},
                    { title: 'Tenant code', field: 'code', width: 180, formatter: function (cell) { return '<code>' + window.PlatformHubGrid.escape(cell.getValue()) + '</code>'; }},
                    { title: 'Status', field: 'status', width: 140, formatter: function (cell) {
                        const active = cell.getValue() === 'Active';
                        return '<span class="badge rounded-pill ' + (active ? 'text-bg-success' : 'text-bg-secondary') + '">' + window.PlatformHubGrid.escape(cell.getValue()) + '</span>';
                    }},
                    @if (canManage)
                    {
                        <text>{ title: 'Actions', field: 'id', minWidth: 190, headerSort: false, formatter: function (cell) {
                            const row = cell.getRow().getData();
                            const id = Number(row.id);
                            let html = '<div class="tv-actions">';
                            if (canUpdate) html += '<button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editTenant-' + id + '">Edit</button>';
                            if (canDeactivate) {
                                const action = row.isActive ? 'Delete' : 'Activate';
                                const label = row.isActive ? 'Deactivate' : 'Activate';
                                const message = row.isActive ? 'Deactivate this tenant?' : 'Activate this tenant?';
                                html += '<form method="post" action="/PlatformAdmin/Tenants/' + action + '" data-confirm="' + message + '" class="d-inline">' +
                                    '<input type="hidden" name="__RequestVerificationToken" value="' + window.PlatformHubGrid.escape(token) + '">' +
                                    '<input type="hidden" name="id" value="' + id + '">' +
                                    (row.isActive ? '<input type="hidden" name="hardDelete" value="false">' : '') +
                                    '<button type="submit" class="btn btn-sm ' + (row.isActive ? 'btn-outline-danger' : 'btn-outline-success') + '">' + label + '</button></form>';
                            }
                            html += '</div>';
                            return html;
                        }}</text>
                    }
                ]
            });
            }
            if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', initTenantGrid, { once: true });
            else initTenantGrid();
        })();
    </script>
</section>
