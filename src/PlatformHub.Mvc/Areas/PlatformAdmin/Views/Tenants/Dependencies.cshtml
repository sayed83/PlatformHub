@using PlatformHub.Mvc.Areas.PlatformAdmin.Models
@model TenantDependencyViewModel
@{
    ViewData["Title"] = "Tenant dependencies";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var blockers = Model.Branches.Count + Model.Projects.Count + Model.RoleAssignments.Count;
}
<div class="d-flex flex-wrap justify-content-between align-items-start gap-3 mb-4">
    <div>
        <a asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index" class="text-decoration-none small">← Tenant management</a>
        <h1 class="h3 fw-bold mt-2 mb-1">Tenant dependency details</h1>
        <p class="text-secondary mb-0">Review related records before permanently deleting this tenant.</p>
    </div>
    <span class="badge rounded-pill @(Model.Tenant.IsActive ? "text-bg-success" : "text-bg-secondary")">@(Model.Tenant.IsActive ? "Active" : "Inactive")</span>
</div>
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-body p-4">
        <div class="d-flex flex-wrap justify-content-between gap-3">
            <div><div class="small text-secondary">Tenant</div><div class="h4 fw-bold mb-1">@Model.Tenant.Name</div><div class="text-secondary">Code: <code>@Model.Tenant.Code</code> · ID: @Model.Tenant.Id</div></div>
            <div class="d-flex gap-2 flex-wrap">
                <div class="border rounded-3 p-3 text-center"><div class="small text-secondary">Branches</div><div class="fs-4 fw-bold">@Model.Branches.Count</div></div>
                <div class="border rounded-3 p-3 text-center"><div class="small text-secondary">Projects</div><div class="fs-4 fw-bold">@Model.Projects.Count</div></div>
                <div class="border rounded-3 p-3 text-center"><div class="small text-secondary">Role assignments</div><div class="fs-4 fw-bold">@Model.RoleAssignments.Count</div></div>
            </div>
        </div>
    </div>
</div>
@if (blockers > 0)
{
    <div class="alert alert-warning"><h2 class="h6 fw-bold">Hard delete is blocked</h2><p class="mb-1">This tenant has @blockers related record(s). Review the lists below and resolve the dependencies first. Soft delete remains available and retains the data.</p></div>
}
else
{
    <div class="alert alert-success"><strong>No known dependencies found.</strong> The tenant may be eligible for hard deletion. The API will perform the final validation.</div>
}
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-body p-3"><h2 class="h5 fw-bold mb-0">Branches (@Model.Branches.Count)</h2></div>
    @if (Model.Branches.Count == 0) { <div class="p-4 text-secondary">No branches belong to this tenant.</div> }
    else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-3">Branch</th><th>Code</th><th>Status</th><th>Branch management</th></tr></thead><tbody>@foreach (var b in Model.Branches) { <tr><td class="ps-3">@b.Name <span class="text-secondary small">(#@b.Id)</span></td><td><code>@b.Code</code></td><td>@(b.IsActive ? "Active" : "Inactive")</td><td><a class="btn btn-sm btn-outline-primary" asp-area="PlatformAdmin" asp-controller="Branches" asp-action="Index" asp-route-tenantId="@Model.Tenant.Id" asp-route-highlightBranchId="@b.Id">Open branch</a></td></tr> }</tbody></table></div> }
</div>
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-body p-3 d-flex justify-content-between align-items-center"><h2 class="h5 fw-bold mb-0">Projects (@Model.Projects.Count)</h2><a asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Index" asp-route-tenantId="@Model.Tenant.Id" class="btn btn-sm btn-outline-primary">View projects</a></div>
    @if (Model.Projects.Count == 0) { <div class="p-4 text-secondary">No projects belong to this tenant.</div> }
    else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-3">Project</th><th>Code</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach (var p in Model.Projects) { <tr><td class="ps-3">@p.Name <span class="text-secondary small">(#@p.Id)</span></td><td><code>@p.Code</code></td><td>@(p.IsActive ? "Active" : "Inactive")</td><td><a class="btn btn-sm btn-outline-primary" asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Index" asp-route-tenantId="@Model.Tenant.Id" asp-route-highlightProjectId="@p.Id">Open project</a></td></tr> }</tbody></table></div> }
</div>
<div class="card border-0 shadow-sm rounded-4 mb-4">
    <div class="card-header bg-body p-3"><h2 class="h5 fw-bold mb-0">Role assignments (@Model.RoleAssignments.Count)</h2></div>
    @if (Model.RoleAssignments.Count == 0) { <div class="p-4 text-secondary">No role assignments are linked to this tenant, its branches, or its projects.</div> }
    else { <div class="table-responsive"><table class="table table-hover align-middle mb-0"><thead class="table-light"><tr><th class="ps-3">User</th><th>Role</th><th>Scope</th><th>Status</th><th>Action</th></tr></thead><tbody>@foreach (var a in Model.RoleAssignments) { <tr><td class="ps-3"><div class="fw-semibold">@a.DisplayName</div><div class="small text-secondary">@a.UserName · User #@a.UserId</div></td><td><div>@a.RoleName</div><code>@a.RoleCode</code></td><td>@(a.TenantId == Model.Tenant.Id ? "Tenant-wide" : a.BranchName is not null ? "Branch: " + a.BranchName : a.ProjectName is not null ? "Project: " + a.ProjectName : "Related scope")</td><td>@(a.IsUserActive && a.IsRoleActive ? "Active" : "Inactive user or role")</td><td><a class="btn btn-sm btn-outline-primary" asp-area="PlatformAdmin" asp-controller="Users" asp-action="Index" asp-route-search="@a.UserName" asp-route-highlightAssignmentId="@a.Id">Open assignment</a></td></tr> }</tbody></table></div> }
</div>
<div class="d-flex flex-wrap justify-content-between gap-2 mb-4">
    <a asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index" class="btn btn-outline-secondary">Back to tenants</a>
    <div class="d-flex flex-wrap gap-2">
        @if (Model.Tenant.IsActive)
        {
            <form asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Delete" method="post" data-confirm="Deactivate this tenant? Its related data will be retained.">
                @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Tenant.Id" /><input type="hidden" name="hardDelete" value="false" />
                <button type="submit" class="btn btn-outline-warning">Soft delete tenant</button>
            </form>
        }
        @if (blockers == 0)
        {
            <form asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Delete" method="post" data-confirm="Permanently delete this tenant? This cannot be undone.">
                @Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Tenant.Id" /><input type="hidden" name="hardDelete" value="true" />
                <button type="submit" class="btn btn-danger">Confirm hard delete</button>
            </form>
        }
        else
        {
            <button class="btn btn-danger" disabled title="Resolve the listed dependencies first">Hard delete blocked</button>
        }
    </div>
</div>
