@using PlatformHub.Mvc.Areas.PlatformAdmin.Models
@model DashboardViewModel
@{
    ViewData["Title"] = "Platform Admin Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <div class="text-primary small fw-semibold text-uppercase">PlatformHub control center</div>
        <h1 class="h3 mb-1">Platform Administration</h1>
        <p class="text-secondary mb-0">Welcome back, @Model.DisplayName</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Index" class="btn btn-primary">Manage projects</a>
        <form asp-area="PlatformAdmin" asp-controller="Account" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-secondary">Sign out</button>
        </form>
    </div>
</div>

<div asp-validation-summary="All" class="alert alert-warning" role="alert"></div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body">
        <div class="text-secondary small">Total tenants</div><div class="display-6 fw-semibold">@Model.Summary.TotalTenants</div><div class="small text-success">@Model.Summary.ActiveTenants active</div>
    </div></div></div>
    <div class="col-sm-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body">
        <div class="text-secondary small">Platform users</div><div class="display-6 fw-semibold">@Model.Summary.TotalUsers</div><div class="small text-success">@Model.Summary.ActiveUsers active</div>
    </div></div></div>
    <div class="col-sm-6 col-xl-4"><div class="card border-0 shadow-sm h-100"><div class="card-body">
        <div class="text-secondary small">Projects</div><div class="display-6 fw-semibold">@Model.Summary.TotalProjects</div><div class="small text-success">@Model.Summary.ActiveProjects active</div>
    </div></div></div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2 py-3">
        <div><h2 class="h5 mb-1">Recent tenants</h2><p class="text-secondary small mb-0">Latest five tenants returned by the platform API</p></div>
        <a asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index" class="btn btn-outline-primary btn-sm">Manage tenants</a>
    </div>
    <div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead class="table-light"><tr><th>Code</th><th>Tenant name</th><th>Status</th></tr></thead>
        <tbody>
        @if (Model.Tenants.Count == 0) { <tr><td colspan="3" class="text-center text-secondary py-4">No tenants have been created yet.</td></tr> }
        else
        {
            @foreach (var tenant in Model.Tenants)
            {
                <tr><td class="fw-semibold">@tenant.Code</td><td>@tenant.Name</td><td>@if (tenant.IsActive) { <span class="badge bg-success-subtle text-success">Active</span> } else { <span class="badge bg-secondary-subtle text-secondary">Inactive</span> }</td></tr>
            }
        }
        </tbody>
    </table></div>
</div>
