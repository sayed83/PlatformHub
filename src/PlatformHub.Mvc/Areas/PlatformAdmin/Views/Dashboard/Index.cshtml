@{ ViewData["Title"] = "Platform Admin Dashboard"; Layout = "~/Views/Shared/_Layout.cshtml"; }
<div class="d-flex justify-content-between align-items-center mb-4">
<div><h1 class="h3 mb-1">Platform Administration</h1><p class="text-secondary mb-0">Welcome, @ViewBag.DisplayName</p></div>
<form method="post" action="/PlatformAdmin/Account/Logout">@Html.AntiForgeryToken()<button class="btn btn-outline-secondary">Sign out</button></form>
</div>
<div class="row g-3">
<div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-secondary">Platform API</div><div class="h4">Connected</div><span class="badge bg-success">Authorized</span></div></div></div>
<div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-secondary">Tenant Management</div><div class="h5">API foundation ready</div><p class="small text-secondary mb-0">Tenant list and create endpoints are available.</p></div></div></div>
<div class="col-md-4"><div class="card border-0 shadow-sm"><div class="card-body"><div class="text-secondary">Architecture</div><div class="h5">Clean Architecture</div><p class="small text-secondary mb-0">MVC client → API → Application / Infrastructure / Domain</p></div></div></div>
</div>
