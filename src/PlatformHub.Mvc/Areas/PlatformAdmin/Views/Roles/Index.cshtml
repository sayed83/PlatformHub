@using PlatformHub.Mvc.Areas.PlatformAdmin.Models
@model RoleManagementViewModel
@{
    ViewData["Title"] = "Roles & Permissions";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="mb-4">
    <a asp-area="PlatformAdmin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none small">&larr; Dashboard</a>
    <h1 class="h3 mt-2 mb-1">Roles &amp; permissions</h1>
    <p class="text-secondary mb-0">Create custom roles and control which platform operations each role can perform.</p>
</div>

@if (TempData["SuccessMessage"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["ErrorMessage"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}
<div asp-validation-summary="All" class="alert alert-danger"></div>

<div class="row g-4">
    <div class="col-xl-4">
        <section class="card border-0 shadow-sm">
            <div class="card-body p-4">
                <h2 class="h5 mb-3">Create custom role</h2>
                <form asp-area="PlatformAdmin" asp-controller="Roles" asp-action="Create" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="Code" class="form-label">Role code</label>
                        <input asp-for="Code" class="form-control" placeholder="SUPPORT_MANAGER" />
                        <span asp-validation-for="Code" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Name" class="form-label">Role name</label>
                        <input asp-for="Name" class="form-control" placeholder="Support Manager" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label">Description</label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>
                    <div class="mb-3">
                        <label asp-for="BaseRedirectUrl" class="form-label">Default redirect URL (optional)</label>
                        <input asp-for="BaseRedirectUrl" class="form-control" placeholder="/Workspace" />
                        <div class="form-text">A user-specific redirect should take precedence over this role default.</div>
                    </div>
                    <button class="btn btn-primary w-100" type="submit">Create role</button>
                </form>
            </div>
        </section>
        <section class="card border-0 shadow-sm mt-4">
            <div class="card-body p-4">
                <h2 class="h5">Permission catalog</h2>
                <p class="text-secondary small">Permissions are enforced by the API, not by hiding UI controls.</p>
                @foreach (var group in Model.Permissions.GroupBy(x => x.Module).OrderBy(x => x.Key))
                {
                    <h3 class="small fw-bold text-uppercase text-secondary mt-3">@group.Key</h3>
                    @foreach (var permission in group)
                    {
                        <div class="py-2 border-bottom">
                            <div class="fw-semibold small">@permission.Name</div>
                            <code class="small">@permission.Code</code>
                        </div>
                    }
                }
            </div>
        </section>
    </div>

    <div class="col-xl-8">
        <section class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3">
                <h2 class="h5 mb-0">Platform roles <span class="badge bg-secondary">@Model.Roles.Count</span></h2>
            </div>
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light"><tr><th>Role</th><th>Type</th><th>Permissions</th><th>Status</th></tr></thead>
                    <tbody>
                    @foreach (var role in Model.Roles)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@role.Name</div>
                                <code class="small">@role.Code</code>
                                @if (!string.IsNullOrWhiteSpace(role.Description))
                                {
                                    <div class="small text-secondary mt-1">@role.Description</div>
                                }
                            </td>
                            <td>
                                @if (role.IsSystemRole) { <span class="badge text-bg-dark">Built-in</span> }
                                else { <span class="badge text-bg-primary">Custom</span> }
                            </td>
                            <td>@role.Permissions.Count</td>
                            <td>@if (role.IsActive) { <span class="badge text-bg-success">Active</span> } else { <span class="badge text-bg-secondary">Inactive</span> }</td>
                        </tr>
                        <tr>
                            <td colspan="4" class="bg-body-tertiary">
                                @if (role.IsSystemRole)
                                {
                                    <div class="small text-secondary py-2"><span class="me-2">🔒</span>System role is protected. Its permissions cannot be changed from this screen.</div>
                                }
                                else
                                {
                                    <details>
                                        <summary class="small fw-semibold py-2">Configure permissions for @role.Name</summary>
                                        <form asp-area="PlatformAdmin" asp-controller="Roles" asp-action="SavePermissions" method="post" class="pt-2">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="EditingRoleId" value="@role.Id" />
                                            <div class="row g-2">
                                                @foreach (var permission in Model.Permissions.OrderBy(x => x.Module).ThenBy(x => x.Name))
                                                {
                                                    var selected = role.Permissions.Contains(permission.Code, StringComparer.OrdinalIgnoreCase);
                                                    <div class="col-md-6">
                                                        <label class="border rounded p-2 d-flex gap-2 align-items-start h-100 bg-white">
                                                            <input class="form-check-input mt-1" type="checkbox" name="SelectedPermissionIds" value="@permission.Id" checked="@selected" />
                                                            <span>
                                                                <span class="d-block small fw-semibold">@permission.Name</span>
                                                                <code class="small">@permission.Code</code>
                                                            </span>
                                                        </label>
                                                    </div>
                                                }
                                            </div>
                                            <button type="submit" class="btn btn-sm btn-primary mt-3">Save permissions</button>
                                        </form>
                                    </details>
                                }
                            </td>
                        </tr>
                    }
                    @if (Model.Roles.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-secondary py-4">No roles returned by the API.</td></tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>
    </div>
</div>
