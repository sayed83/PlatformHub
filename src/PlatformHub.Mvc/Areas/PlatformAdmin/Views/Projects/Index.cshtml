@using PlatformHub.Mvc.Areas.PlatformAdmin.Models
@model ProjectManagementViewModel
@{
    ViewData["Title"] = "Project Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var activeCount = Model.Projects.Count(x => x.IsActive);
    var inactiveCount = Model.Projects.Count - activeCount;
    var tenantCount = Model.Projects.Select(x => x.TenantId).Distinct().Count();
}
<style>
    .pm-stat { border: 1px solid var(--bs-border-color); border-radius: .9rem; background: var(--bs-body-bg); padding: 1rem; height: 100%; }
    .pm-stat-label { color: var(--bs-secondary-color); font-size: .78rem; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
    .pm-stat-value { font-size: 1.65rem; line-height: 1.2; font-weight: 700; margin-top: .45rem; }
    .pm-avatar { display:inline-flex; width:2.7rem; height:2.7rem; align-items:center; justify-content:center; flex:0 0 2.7rem; border-radius:.8rem; background:rgba(13,110,253,.12); color:var(--bs-primary); font-weight:700; }
    .pm-table th { white-space:nowrap; color:var(--bs-secondary-color); font-size:.75rem; text-transform:uppercase; letter-spacing:.04em; }
    .pm-table td { padding-top:1rem; padding-bottom:1rem; }
    .pm-hero { border:1px solid var(--bs-border-color); border-radius:1rem; padding:1.4rem; background:linear-gradient(120deg,rgba(13,110,253,.09),rgba(13,110,253,.015)); }
    .pm-symbol { font-size:1.1rem; line-height:1; margin-right:.25rem; }
</style>

<div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <a asp-area="PlatformAdmin" asp-controller="Dashboard" asp-action="Index" class="text-decoration-none small"><span aria-hidden="true">←</span> Dashboard</a>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-2"><h1 class="h3 fw-bold mb-0">Project management</h1><span class="badge rounded-pill text-bg-light border text-dark">Platform administration</span></div>
            <p class="text-secondary mb-0 mt-1">Organize projects under tenants and manage the project directory.</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index" class="btn btn-outline-secondary"><span aria-hidden="true">▦</span> Manage tenants</a>
            @if (Model.Tenants.Any(t => t.IsActive)) { <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createProjectModal"><span aria-hidden="true" class="pm-symbol">＋</span> Create project</button> }
        </div>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success alert-dismissible fade show" role="status">@successMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
    @if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@errorMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
    @if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger"></div>
}

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-3"><div class="pm-stat"><div class="d-flex justify-content-between"><span class="pm-stat-label">Projects shown</span><span class="text-primary fs-5" aria-hidden="true">▦</span></div><div class="pm-stat-value">@Model.Projects.Count</div><div class="small text-secondary mt-1">Current filtered results</div></div></div>
        <div class="col-6 col-xl-3"><div class="pm-stat"><div class="d-flex justify-content-between"><span class="pm-stat-label">Active</span><span class="text-success fs-5" aria-hidden="true">✓</span></div><div class="pm-stat-value">@activeCount</div><div class="small text-secondary mt-1">Available projects</div></div></div>
        <div class="col-6 col-xl-3"><div class="pm-stat"><div class="d-flex justify-content-between"><span class="pm-stat-label">Inactive</span><span class="text-secondary fs-5" aria-hidden="true">Ⅱ</span></div><div class="pm-stat-value">@inactiveCount</div><div class="small text-secondary mt-1">Disabled projects</div></div></div>
        <div class="col-6 col-xl-3"><div class="pm-stat"><div class="d-flex justify-content-between"><span class="pm-stat-label">Tenants represented</span><span class="text-primary fs-5" aria-hidden="true">⌂</span></div><div class="pm-stat-value">@tenantCount</div><div class="small text-secondary mt-1">With projects in this result</div></div></div>
    </div>

    <section class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-body border-bottom p-3 p-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
                <div><h2 class="h5 fw-bold mb-1">Project directory</h2><p class="small text-secondary mb-0">Filter by tenant or search project details in the list below.</p></div>
                <span class="small text-secondary">Tenant → Project</span>
            </div>
            <form asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Index" method="get" class="row g-2 align-items-end">
                <div class="col-12 col-md-8 col-lg-5">
                    <label class="form-label small fw-semibold" for="tenantId">Tenant</label>
                    <select id="tenantId" name="tenantId" class="form-select">
                        <option value="">All tenants</option>
                        @foreach (var tenant in Model.Tenants) { if (Model.TenantId == tenant.Id) { <option value="@tenant.Id" selected>@tenant.Code — @tenant.Name</option> } else { <option value="@tenant.Id">@tenant.Code — @tenant.Name</option> } }
                    </select>
                </div>
                <div class="col-12 col-md-4 col-lg-auto d-flex gap-2">
                    <button type="submit" class="btn btn-primary flex-grow-1"><span aria-hidden="true">⌕</span> Filter</button>
                    <a asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Index" class="btn btn-outline-secondary" title="Clear filter"><span aria-hidden="true">↺</span></a>
                </div>
            </form>
        </div>
        <div class="table-responsive">
            <table class="table pm-table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th class="ps-3 ps-lg-4">Project</th><th>Tenant</th><th>Base URL</th><th>Status</th><th class="text-end pe-3 pe-lg-4">Actions</th></tr></thead>
                <tbody>
                @if (Model.Projects.Count == 0)
                {
                    <tr><td colspan="5" class="text-center py-5"><div class="text-secondary fs-1 mb-2" aria-hidden="true">▦</div><div class="fw-semibold">No projects found</div><div class="small text-secondary mb-3">Try another tenant filter or create a project.</div>@if (Model.Tenants.Any(t => t.IsActive)) { <button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createProjectModal">＋ Create project</button> }</td></tr>
                }
                else
                {
                    @foreach (var project in Model.Projects)
                    {
                        <tr>
                            <td class="ps-3 ps-lg-4">
                                <div class="d-flex align-items-center gap-3"><span class="pm-avatar">@((string.IsNullOrWhiteSpace(project.Name) ? project.Code : project.Name).Trim().Substring(0,1).ToUpperInvariant())</span><div class="min-w-0"><div class="fw-semibold">@project.Name</div><code class="small">@project.Code</code></div></div>
                            </td>
                            <td><div class="fw-semibold">@project.TenantName</div><div class="small text-secondary">Tenant ID: @project.TenantId</div></td>
                            <td>@if (!string.IsNullOrWhiteSpace(project.BaseUrl)) { <a href="@project.BaseUrl" target="_blank" rel="noopener noreferrer" class="text-decoration-none text-break">@project.BaseUrl</a> } else { <span class="text-secondary">Not configured</span> }</td>
                            <td>@if (project.IsActive) { <span class="badge rounded-pill text-bg-success-subtle border border-success-subtle text-success-emphasis">✓ Active</span> } else { <span class="badge rounded-pill text-bg-secondary">Inactive</span> }</td>
                            <td class="text-end pe-3 pe-lg-4">
                                <div class="d-flex flex-wrap justify-content-end gap-1">
                                    <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#editProject-@project.Id">Edit</button>
                                    @if (!project.IsActive)
                                    {
                                        <form asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Activate" method="post" class="d-inline" data-confirm="Activate this project?">
                                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@project.Id" /><input type="hidden" name="tenantId" value="@Model.TenantId" />
                                            <button type="submit" class="btn btn-sm btn-outline-success">Activate</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Delete" method="post" class="d-inline" data-confirm="Deactivate this project? Its data will be retained.">
                                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@project.Id" /><input type="hidden" name="tenantId" value="@Model.TenantId" /><input type="hidden" name="hardDelete" value="false" />
                                            <button type="submit" class="btn btn-sm btn-outline-warning">Soft delete</button>
                                        </form>
                                    }
                                    <form asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Delete" method="post" class="d-inline" data-confirm="Permanently delete this project? This cannot be undone.">
                                        @Html.AntiForgeryToken()<input type="hidden" name="id" value="@project.Id" /><input type="hidden" name="tenantId" value="@Model.TenantId" /><input type="hidden" name="hardDelete" value="true" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Hard delete</button>
                                    </form>
                                </div>
                                <div class="modal fade text-start" id="editProject-@project.Id" tabindex="-1" aria-labelledby="editProjectTitle-@project.Id" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-lg"><div class="modal-content">
                                        <form asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Edit" method="post">
                                            @Html.AntiForgeryToken()<input type="hidden" name="id" value="@project.Id" /><input type="hidden" name="tenantId" value="@Model.TenantId" />
                                            <div class="modal-header"><div><h2 class="modal-title h5 fw-bold" id="editProjectTitle-@project.Id">Edit project</h2><p class="small text-secondary mb-0">@project.TenantName</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                                            <div class="modal-body"><div class="row g-3">
                                                <div class="col-md-6"><label class="form-label" for="projectCode-@project.Id">Project code</label><input class="form-control" id="projectCode-@project.Id" name="code" value="@project.Code" maxlength="50" pattern="[A-Za-z0-9_-]+" required /></div>
                                                <div class="col-md-6"><label class="form-label" for="projectName-@project.Id">Project name</label><input class="form-control" id="projectName-@project.Id" name="name" value="@project.Name" maxlength="200" required /></div>
                                                <div class="col-12"><label class="form-label" for="projectBaseUrl-@project.Id">Base URL (optional)</label><input class="form-control" type="url" id="projectBaseUrl-@project.Id" name="baseUrl" value="@project.BaseUrl" maxlength="500" placeholder="https://example.com" /></div>
                                            </div></div>
                                            <div class="modal-footer"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary">Save changes</button></div>
                                        </form>
                                    </div></div>
                                </div>
                            </td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-body d-flex flex-wrap justify-content-between gap-2 small text-secondary"><span>Showing @Model.Projects.Count project(s)</span><span>Projects are associated with a tenant.</span></div>
    </section>
</div>

@if (Model.Tenants.Any(t => t.IsActive))
{
    <div class="modal fade" id="createProjectModal" tabindex="-1" aria-labelledby="createProjectTitle" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable"><div class="modal-content border-0 shadow rounded-4">
            <form asp-area="PlatformAdmin" asp-controller="Projects" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header px-4 pt-4"><div><h2 class="modal-title h5 fw-bold" id="createProjectTitle">Create project</h2><p class="small text-secondary mb-0">A project must belong to an active tenant.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
                <div class="modal-body px-4">
                    <div class="row g-3">
                        <div class="col-12"><label asp-for="TenantId" class="form-label fw-semibold">Tenant</label><select asp-for="TenantId" class="form-select"><option value="0">Select tenant</option>@foreach (var tenant in Model.Tenants.Where(t => t.IsActive)) { <option value="@tenant.Id">@tenant.Code — @tenant.Name</option> }</select><span asp-validation-for="TenantId" class="text-danger small"></span></div>
                        <div class="col-md-6"><label asp-for="Code" class="form-label fw-semibold">Project code</label><input asp-for="Code" class="form-control" placeholder="e.g. ERP" maxlength="50"/><div class="form-text">Letters, numbers, hyphens, and underscores.</div><span asp-validation-for="Code" class="text-danger small"></span></div>
                        <div class="col-md-6"><label asp-for="Name" class="form-label fw-semibold">Project name</label><input asp-for="Name" class="form-control" placeholder="Project display name" maxlength="200"/><span asp-validation-for="Name" class="text-danger small"></span></div>
                        <div class="col-12"><label asp-for="BaseUrl" class="form-label fw-semibold">Base URL <span class="text-secondary fw-normal">(optional)</span></label><input asp-for="BaseUrl" class="form-control" placeholder="https://project.example.com" maxlength="500"/><div class="form-text">Use a full URL including https://, or leave it empty.</div><span asp-validation-for="BaseUrl" class="text-danger small"></span></div>
                    </div>
                </div>
                <div class="modal-footer px-4 pb-4"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary"><span aria-hidden="true">✓</span> Create project</button></div>
            </form>
        </div></div>
    </div>
}
