@using PlatformHub.Mvc.Areas.PlatformAdmin.Models
@model BranchManagementViewModel
@{
    ViewData["Title"] = "Branch Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <a asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index" class="text-decoration-none small">&larr; Tenant management</a>
        <h1 class="h3 mt-2 mb-1">Branch management</h1>
        <p class="text-secondary mb-0">Tenant: <strong>@Model.TenantName</strong>. Each branch belongs to this tenant.</p>
    </div>
</div>
@if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success" role="status">@successMessage</div> }
<div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm"><div class="card-body p-4">
            <h2 class="h5 mb-3">Create branch</h2>
            <form asp-area="PlatformAdmin" asp-controller="Branches" asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="TenantId" type="hidden" />
                <div class="mb-3"><label asp-for="Code" class="form-label">Branch code</label><input asp-for="Code" class="form-control" placeholder="DHAKA-01" maxlength="50" /><span asp-validation-for="Code" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="Name" class="form-label">Branch name</label><input asp-for="Name" class="form-control" placeholder="Dhaka Main Branch" maxlength="200" /><span asp-validation-for="Name" class="text-danger"></span></div>
                <div class="mb-3"><label asp-for="Address" class="form-label">Address (optional)</label><textarea asp-for="Address" class="form-control" rows="3" maxlength="500" placeholder="Branch address"></textarea><span asp-validation-for="Address" class="text-danger"></span></div>
                <button type="submit" class="btn btn-primary w-100">Create branch</button>
            </form>
        </div></div>
    </div>
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white py-3"><h2 class="h5 mb-0">Branches <span class="badge bg-secondary">@Model.Branches.Count</span></h2></div>
            <div class="table-responsive"><table class="table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th>Code</th><th>Branch name</th><th>Address</th><th>Status</th></tr></thead>
                <tbody>
                @if (Model.Branches.Count == 0) { <tr><td colspan="4" class="text-center text-secondary py-4">No branches created for this tenant yet.</td></tr> }
                else
                {
                    @foreach (var branch in Model.Branches)
                    {
                        <tr><td class="fw-semibold">@branch.Code</td><td>@branch.Name</td><td>@(string.IsNullOrWhiteSpace(branch.Address) ? "—" : branch.Address)</td><td>@if (branch.IsActive) { <span class="badge bg-success">Active</span> } else { <span class="badge bg-secondary">Inactive</span> }</td></tr>
                    }
                }
                </tbody>
            </table></div>
        </div>
    </div>
</div>
