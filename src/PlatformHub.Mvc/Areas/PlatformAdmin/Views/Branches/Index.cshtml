@using PlatformHub.Mvc.Areas.PlatformAdmin.Models
@model BranchManagementViewModel
@{
    ViewData["Title"] = "Branch Management";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var activeCount = Model.Branches.Count(x => x.IsActive);
    var inactiveCount = Model.Branches.Count - activeCount;
}
<style>
    .bm-stat { border:1px solid var(--bs-border-color); border-radius:.9rem; background:var(--bs-body-bg); padding:1rem; height:100%; }
    .bm-stat-label { color:var(--bs-secondary-color); font-size:.78rem; font-weight:600; letter-spacing:.04em; text-transform:uppercase; }
    .bm-stat-value { font-size:1.65rem; line-height:1.2; font-weight:700; margin-top:.45rem; }
    .bm-avatar { display:inline-flex; width:2.7rem; height:2.7rem; align-items:center; justify-content:center; flex:0 0 2.7rem; border-radius:.8rem; background:rgba(13,110,253,.12); color:var(--bs-primary); font-weight:700; }
    .bm-table th { white-space:nowrap; color:var(--bs-secondary-color); font-size:.75rem; text-transform:uppercase; letter-spacing:.04em; }
    .bm-table td { padding-top:1rem; padding-bottom:1rem; }
</style>

<div>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <a asp-area="PlatformAdmin" asp-controller="Tenants" asp-action="Index" class="text-decoration-none small"><span aria-hidden="true">←</span> Tenant management</a>
            <div class="d-flex flex-wrap align-items-center gap-2 mt-2"><h1 class="h3 fw-bold mb-0">Branch management</h1><span class="badge rounded-pill text-bg-light border text-dark">Tenant branches</span></div>
            <p class="text-secondary mb-0 mt-1">Manage locations and branch details for <strong>@Model.TenantName</strong>.</p>
        </div>
        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createBranchModal"><span aria-hidden="true" class="bm-symbol">＋</span> Create branch</button>
    </div>

    @if (TempData["SuccessMessage"] is string successMessage) { <div class="alert alert-success alert-dismissible fade show" role="status">@successMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
    @if (TempData["ErrorMessage"] is string errorMessage) { <div class="alert alert-danger alert-dismissible fade show" role="alert">@errorMessage<button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button></div> }
    @if (!ViewData.ModelState.IsValid)
{
    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
}

    <div class="row g-3 mb-4">
        <div class="col-6 col-xl-4"><div class="bm-stat"><div class="d-flex justify-content-between"><span class="bm-stat-label">Branches shown</span><span class="text-primary fs-5" aria-hidden="true">⌂</span></div><div class="bm-stat-value">@Model.Branches.Count</div><div class="small text-secondary mt-1">Locations under this tenant</div></div></div>
        <div class="col-6 col-xl-4"><div class="bm-stat"><div class="d-flex justify-content-between"><span class="bm-stat-label">Active</span><span class="text-success fs-5" aria-hidden="true">✓</span></div><div class="bm-stat-value">@activeCount</div><div class="small text-secondary mt-1">Enabled branches</div></div></div>
        <div class="col-12 col-xl-4"><div class="bm-stat"><div class="d-flex justify-content-between"><span class="bm-stat-label">Inactive</span><span class="text-secondary fs-5" aria-hidden="true">Ⅱ</span></div><div class="bm-stat-value">@inactiveCount</div><div class="small text-secondary mt-1">Disabled branches</div></div></div>
    </div>

    <section class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="card-header bg-body border-bottom p-3 p-lg-4">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div><h2 class="h5 fw-bold mb-1">Branch directory</h2><p class="small text-secondary mb-0">Branch codes, addresses, and current status for this tenant.</p></div>
                <span class="small text-secondary">Tenant: @Model.TenantName</span>
            </div>
        </div>
        <div class="table-responsive">
            <table class="table bm-table table-hover align-middle mb-0">
                <thead class="table-light"><tr><th class="ps-3 ps-lg-4">Branch</th><th>Branch code</th><th>Address</th><th>Status</th></tr></thead>
                <tbody>
                @if (Model.Branches.Count == 0)
                {
                    <tr><td colspan="4" class="text-center py-5"><div class="text-secondary fs-1 mb-2" aria-hidden="true">⌂</div><div class="fw-semibold">No branches yet</div><div class="small text-secondary mb-3">Add the first branch for this tenant.</div><button type="button" class="btn btn-sm btn-primary" data-bs-toggle="modal" data-bs-target="#createBranchModal">＋ Create branch</button></td></tr>
                }
                else
                {
                    @foreach (var branch in Model.Branches)
                    {
                        <tr>
                            <td class="ps-3 ps-lg-4"><div class="d-flex align-items-center gap-3"><span class="bm-avatar">@((string.IsNullOrWhiteSpace(branch.Name) ? branch.Code : branch.Name).Trim().Substring(0,1).ToUpperInvariant())</span><div class="min-w-0"><div class="fw-semibold">@branch.Name</div><div class="small text-secondary">Branch ID: @branch.Id</div></div></div></td>
                            <td><code class="fw-semibold">@branch.Code</code></td>
                            <td><div class="text-break">@(string.IsNullOrWhiteSpace(branch.Address) ? "Address not provided" : branch.Address)</div></td>
                            <td>@if (branch.IsActive) { <span class="badge rounded-pill text-bg-success-subtle border border-success-subtle text-success-emphasis">✓ Active</span> } else { <span class="badge rounded-pill text-bg-secondary">Inactive</span> }</td>
                        </tr>
                    }
                }
                </tbody>
            </table>
        </div>
        <div class="card-footer bg-body small text-secondary d-flex flex-wrap justify-content-between gap-2"><span>Showing @Model.Branches.Count branch(es)</span><span>Every branch belongs to this tenant.</span></div>
    </section>
</div>

<div class="modal fade" id="createBranchModal" tabindex="-1" aria-labelledby="createBranchTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable"><div class="modal-content border-0 shadow rounded-4">
        <form asp-area="PlatformAdmin" asp-controller="Branches" asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="TenantId" type="hidden" />
            <div class="modal-header px-4 pt-4"><div><h2 class="modal-title h5 fw-bold" id="createBranchTitle">Create branch</h2><p class="small text-secondary mb-0">Add a branch under <strong>@Model.TenantName</strong>.</p></div><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
            <div class="modal-body px-4">
                <div class="row g-3">
                    <div class="col-md-6"><label asp-for="Code" class="form-label fw-semibold">Branch code</label><input asp-for="Code" class="form-control" placeholder="e.g. DHAKA-01" maxlength="50" autocomplete="off"/><span asp-validation-for="Code" class="text-danger small"></span></div>
                    <div class="col-md-6"><label asp-for="Name" class="form-label fw-semibold">Branch name</label><input asp-for="Name" class="form-control" placeholder="Branch display name" maxlength="200"/><span asp-validation-for="Name" class="text-danger small"></span></div>
                    <div class="col-12"><label asp-for="Address" class="form-label fw-semibold">Address <span class="text-secondary fw-normal">(optional)</span></label><textarea asp-for="Address" class="form-control" rows="3" maxlength="500" placeholder="Street, city, area..."></textarea><span asp-validation-for="Address" class="text-danger small"></span></div>
                </div>
            </div>
            <div class="modal-footer px-4 pb-4"><button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary"><span aria-hidden="true">✓</span> Create branch</button></div>
        </form>
    </div></div>
</div>
