@{
    ViewData["Title"] = "Menu Policy Editor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .policy-shell {
        min-width: 0;
    }

    .policy-hero {
        border: 1px solid var(--bs-border-color);
        border-radius: 1rem;
        padding: 1.25rem 1.4rem;
        background: linear-gradient(120deg,rgba(13,110,253,.09),rgba(13,110,253,.015));
    }

    .policy-project-card {
        min-width: min(100%,320px);
        padding: .85rem 1rem;
        border: 1px solid var(--bs-border-color);
        border-radius: .85rem;
        background: var(--bs-body-bg);
    }

    .policy-help {
        border: 1px solid var(--bs-border-color);
        border-radius: .8rem;
        background: var(--bs-tertiary-bg);
        padding: .85rem 1rem;
    }

    .policy-card-head {
        border-bottom: 1px solid var(--bs-border-color);
    }

    .policy-savebar {
        position: sticky;
        bottom: 0;
        z-index: 5;
        background: var(--bs-body-bg);
        border-top: 1px solid var(--bs-border-color);
    }

    .policy-table tbody tr:nth-child(even) td:not(:first-child) {
        background: rgba(127,127,127,.025);
    }

    .policy-table td:first-child {
        box-shadow: 2px 0 5px rgba(20,20,40,.035);
    }

    .policy-check:focus-visible, .policy-decision:focus-visible {
        outline: 3px solid rgba(13,110,253,.35);
        outline-offset: 2px;
    }

    .policy-table-wrap:has(tbody tr:nth-child(2)) {
        scroll-behavior: smooth;
    }

    .policy-tabs {
        border-bottom: 1px solid #ded9e8;
        gap: .35rem;
        flex-wrap: wrap;
    }

        .policy-tabs .nav-link {
            color: #746783;
            border: 0;
            border-bottom: 3px solid transparent;
            border-radius: 0;
            padding: .8rem 1rem;
            font-weight: 600;
        }

            .policy-tabs .nav-link.active {
                color: #793ee0;
                background: transparent;
                border-bottom-color: #793ee0;
            }

    .policy-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        align-items: center;
        justify-content: space-between;
    }

    .policy-search {
        position: relative;
        width: min(100%,380px);
    }

        .policy-search input {
            padding-left: 2.5rem;
        }

        .policy-search span {
            position: absolute;
            left: .85rem;
            top: .48rem;
            color: #80778b;
        }

    .policy-table-wrap {
        border: 1px solid #e2deea;
        border-radius: .8rem;
        overflow: auto;
        max-height: calc(100vh - 360px);
        min-height: 260px;
    }

    .policy-table {
        margin: 0;
        white-space: nowrap;
    }

        .policy-table thead th {
            position: sticky;
            top: 0;
            z-index: 3;
            background: #f8f7fb;
            vertical-align: middle;
            border-bottom: 1px solid #ded9e8;
        }

        .policy-table th:first-child, .policy-table td:first-child {
            position: sticky;
            left: 0;
            z-index: 2;
            background: #fff;
            min-width: 245px;
            max-width: 340px;
            white-space: normal;
        }

        .policy-table thead th:first-child {
            z-index: 4;
            background: #f8f7fb;
        }

        .policy-table th.policy-column {
            min-width: 145px;
            text-align: center;
        }

        .policy-table td.policy-cell {
            text-align: center;
            vertical-align: middle;
            min-width: 145px;
        }

        .policy-table tr:hover td {
            background: #fbf9ff;
        }

            .policy-table tr:hover td:first-child {
                background: #fbf9ff;
            }

    .policy-role-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .4rem;
        border-radius: 999px;
        padding: .45rem .75rem;
        font-size: .85rem;
        font-weight: 700;
    }

        .policy-role-chip.role {
            background: #f1e7ff;
            color: #7137c8;
        }

        .policy-role-chip.user {
            background: #e4f4ed;
            color: #177b4a;
        }

    .policy-check {
        width: 1.25rem;
        height: 1.25rem;
        cursor: pointer;
        accent-color: #8548e8;
    }

    .policy-menu-name {
        display: flex;
        align-items: center;
        gap: .55rem;
    }

    .policy-menu-icon {
        width: 1.4rem;
        text-align: center;
        color: #7b718b;
        flex-shrink: 0;
    }

    .policy-code {
        color: #8c8497;
        font-size: .75rem;
        overflow-wrap: anywhere;
    }

    .policy-decision {
        min-width: 125px;
        max-width: 160px;
        margin: auto;
    }

    .policy-legend {
        display: flex;
        flex-wrap: wrap;
        gap: .75rem;
        font-size: .8rem;
        color: #746b80;
    }

        .policy-legend span {
            display: inline-flex;
            align-items: center;
            gap: .35rem;
        }

    .policy-dot {
        width: .6rem;
        height: .6rem;
        display: inline-block;
        border-radius: 50%;
    }

    .policy-status {
        min-height: 0;
    }

    @@media(max-width:767.98px) {
        .policy-table-wrap {
            max-height: calc(100vh - 310px);
        }

        .policy-table th:first-child, .policy-table td:first-child {
            min-width: 185px;
        }

        .policy-table th.policy-column, .policy-table td.policy-cell {
            min-width: 125px;
        }
    }
</style>

<div class="policy-shell">
    <section class="policy-hero d-flex flex-wrap align-items-center justify-content-between gap-3 mb-3">
        <div class="flex-grow-1">
            <div class="text-primary small fw-bold text-uppercase mb-1">Access control · Configuration</div>
            <h1 class="h3 fw-bold mb-1">Menu Policy Editor</h1>
            <p class="text-secondary mb-0">Control which roles and individual users can see project menu entries.</p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <span class="badge rounded-pill text-bg-light border text-dark">Role-based access</span>
                <span class="badge rounded-pill text-bg-light border text-dark">User overrides</span>
                <span class="badge rounded-pill text-bg-light border text-dark">Project-specific</span>
            </div>
        </div>
        <div class="policy-project-card" style="min-width:min(100%,340px)">
            <label class="form-label fw-semibold mb-1" for="projectSelect">Project</label>
            <select id="projectSelect" class="form-select"><option value="">Loading projects…</option></select>
            <label class="form-label fw-semibold mt-3 mb-1" for="tenantSelect">Tenant using this project</label>
            <select id="tenantSelect" class="form-select" disabled><option value="">Select a project first</option></select>
            <div class="small text-secondary mt-2">Select a reusable project, then choose one of the tenants assigned to it.</div>
        </div>
    </section>
    <div class="policy-help small text-secondary mb-3"><strong class="text-body">How it works:</strong> Set role defaults in the first tab. Use the user override tab only for exceptions: <strong>Inherit</strong> uses role access, while <strong>Allow</strong> or <strong>Deny</strong> overrides it for that user.</div>

    <div id="notice" class="alert d-none policy-status py-2" role="status" aria-live="polite"></div>

    <ul class="nav policy-tabs mb-3" role="tablist">
        <li class="nav-item"><button class="nav-link active" id="role-tab" data-bs-toggle="tab" data-bs-target="#rolePane" type="button" role="tab"><span aria-hidden="true">▦</span> Role-wise menu access</button></li>
        <li class="nav-item"><button class="nav-link" id="user-tab" data-bs-toggle="tab" data-bs-target="#userPane" type="button" role="tab"><span aria-hidden="true">♙</span> User-wise menu access</button></li>
    </ul>

    <div class="tab-content">
        <section class="tab-pane fade show active" id="rolePane" role="tabpanel" aria-labelledby="role-tab">
            <div class="card border-0 shadow-sm">
                <div class="card-body pb-3 policy-card-head">
                    <div class="policy-toolbar">
                        <div><h2 class="h5 fw-bold mb-1">Role permission matrix</h2><p class="text-secondary small mb-0">Each column is a role; each row is a menu entry. Checked means allowed.</p></div>
                        <div class="policy-search"><span aria-hidden="true">⌕</span><input id="roleSearch" class="form-control" type="search" placeholder="Search menu or module…" aria-label="Search role menu matrix"></div>
                    </div>
                </div>
                <div class="policy-table-wrap">
                    <table class="table table-bordered policy-table" id="roleMatrix">
                        <thead><tr id="roleHead"><th>Menu / resource</th><th class="text-secondary">Select a project</th></tr></thead>
                        <tbody id="roleRows"><tr><td colspan="2" class="text-center text-secondary py-5">Choose a project to load the role matrix.</td></tr></tbody>
                    </table>
                </div>
                <div class="card-body policy-savebar d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div><div class="policy-legend"><span><i class="policy-dot" style="background:#198754"></i> Allowed</span><span><i class="policy-dot" style="background:#c7c2ce"></i> Denied</span></div><div class="small text-secondary mt-1">Save is enabled after you change a permission.</div></div>
                    <button class="btn btn-primary px-3" id="saveRole" disabled><span aria-hidden="true">✓</span> Save role permissions</button>
                </div>
            </div>
        </section>

        <section class="tab-pane fade" id="userPane" role="tabpanel" aria-labelledby="user-tab">
            <div class="card border-0 shadow-sm">
                <div class="card-body pb-3 policy-card-head">
                    <div class="policy-toolbar">
                        <div><h2 class="h5 fw-bold mb-1">User override matrix</h2><p class="text-secondary small mb-0">Use this only when a user needs an exception to their role defaults.</p></div>
                        <div class="policy-search"><span aria-hidden="true">⌕</span><input id="userSearch" class="form-control" type="search" placeholder="Search menu or module…" aria-label="Search user menu matrix"></div>
                    </div>
                    <div class="policy-legend mt-3"><span><i class="policy-dot" style="background:#198754"></i> Allow</span><span><i class="policy-dot" style="background:#dc3545"></i> Deny</span><span><i class="policy-dot" style="background:#9a8da9"></i> Inherit from roles</span></div>
                </div>
                <div class="policy-table-wrap">
                    <table class="table table-bordered policy-table" id="userMatrix">
                        <thead><tr id="userHead"><th>Menu / resource</th><th class="text-secondary">Select a project</th></tr></thead>
                        <tbody id="userRows"><tr><td colspan="2" class="text-center text-secondary py-5">Choose a project to load the user matrix.</td></tr></tbody>
                    </table>
                </div>
                <div class="card-body policy-savebar d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <div class="small text-secondary">Only Allow/Deny entries are stored; Inherit removes a user override.</div>
                    <button class="btn btn-primary px-3" id="saveUser" disabled><span aria-hidden="true">✓</span> Save user overrides</button>
                </div>
            </div>
        </section>
    </div>
</div>

<script>
    // Wait until the page AND the layout scripts (jQuery / Select2) are loaded,
    // so the project dropdown change event can be bound correctly.
    document.addEventListener('DOMContentLoaded', () => {
        const project = document.getElementById('projectSelect');
        const tenant = document.getElementById('tenantSelect');
        const roleHead = document.getElementById('roleHead');
        const userHead = document.getElementById('userHead');
        const roleRows = document.getElementById('roleRows');
        const userRows = document.getElementById('userRows');
        const roleSearch = document.getElementById('roleSearch');
        const userSearch = document.getElementById('userSearch');
        const saveRoleButton = document.getElementById('saveRole');
        const saveUserButton = document.getElementById('saveUser');
        const baseUrl = '@Url.Action("Data", "MenuAccess", new { area = "PlatformAdmin" })';
        const saveRoleUrl = '@Url.Action("SaveRole", "MenuAccess", new { area = "PlatformAdmin" })';
        const saveUserUrl = '@Url.Action("SaveUser", "MenuAccess", new { area = "PlatformAdmin" })';
        const csrf = '@Html.AntiForgeryToken()';
        let menus = [], roles = [], users = [];
        let roleState = new Map(), userState = new Map();
        let dirtyRoles = new Set(), dirtyUsers = new Set();
        let loadToken = 0; // guards against an older project response overwriting a newer one

        // Bind a change handler that works with BOTH plain <select> and Select2.
        // Select2 raises jQuery events, which addEventListener('change') may not receive.
        function bindChange(el, handler) {
            if (!el) return;
            if (window.jQuery) {
                window.jQuery(el).off('change.menuPolicy').on('change.menuPolicy', handler);
            } else {
                el.addEventListener('change', handler);
            }
        }

        // After changing a select's options from code, refresh the Select2 display.
        function refreshSelect2(el) {
            if (el && window.jQuery && window.jQuery(el).hasClass('select2-hidden-accessible')) {
                window.jQuery(el).trigger('change.select2');
            }
        }

        const esc = value => String(value ?? '').replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
        const requestUrl = (kind, projectId, selectionId = 0) => {
            let url = baseUrl + '?kind=' + encodeURIComponent(kind) + '&projectId=' + encodeURIComponent(projectId) + '&selectionId=' + encodeURIComponent(selectionId);
            if (kind === 'lookups') url += '&tenantId=' + encodeURIComponent(tenant.value || 0);
            return url;
        };
        const notice = (message, type = 'success') => {
            const node = document.getElementById('notice');
            node.textContent = message;
            node.className = 'alert alert-' + type + ' policy-status py-2';
        };
        async function get(url) {
            let response;
            try {
                response = await fetch(url, { credentials: 'same-origin', cache: 'no-store' });
            } catch {
                throw new Error('Could not reach the MVC server. Check that PlatformHub.Mvc is running.');
            }
            const data = await response.json().catch(() => ({}));
            if (response.status === 401) {
                window.location.replace('/PlatformAdmin/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search));
                throw new Error('Your session expired. Redirecting to Platform Admin login…');
            }
            if (!response.ok) {
                const endpoint = url.split('?')[0].split('/').pop();
                throw new Error((data.message || 'Could not load menu permissions.') +
                    ' (HTTP ' + response.status + ', request: ' + endpoint + ')');
            }
            return data;
        }
        async function post(url, payload) {
            const form = document.createElement('form');
            form.innerHTML = csrf;
            const token = form.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            if (!token) throw new Error('Security token is missing. Refresh the page and try again.');

            let response;
            try {
                response = await fetch(url, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': token,
                        'X-Requested-With': 'XMLHttpRequest'
                    },
                    body: JSON.stringify(payload)
                });
            } catch {
                throw new Error('Could not reach PlatformHub. Check the MVC and API applications, then try again.');
            }

            const data = await response.json().catch(() => ({}));
            if (!response.ok) {
                if (response.status === 400 && data.errors) {
                    const details = Object.values(data.errors).flat().filter(Boolean).join(' ');
                    throw new Error(details || data.message || 'The server rejected the submitted access changes.');
                }
                if (response.status === 401) {
                    throw new Error('Your session has expired. Sign in again, then retry saving the user overrides.');
                }
                if (response.status === 403) {
                    throw new Error('You do not have permission to save user menu overrides.');
                }
                throw new Error((data.message || 'Could not save menu permissions.') + ' (HTTP ' + response.status + ')');
            }
            return data;
        }
        function options(select, items, label, placeholder) {
            select.innerHTML = '<option value="">' + esc(placeholder) + '</option>' +
                items.map(item => '<option value="' + item.id + '">' + esc(label(item)) + '</option>').join('');
            refreshSelect2(select);
        }
        function menuCell(menu) {
            const depth = menu.parentMenuId ? 1 : 0;
            return '<div class="policy-menu-name" style="padding-left:' + (depth * 1.2) + 'rem">' +
                '<span class="policy-menu-icon" aria-hidden="true">' + esc(menu.icon || (menu.parentMenuId ? '↳' : '▤')) + '</span>' +
                '<div><div class="fw-semibold">' + esc(menu.name) + '</div><div class="policy-code">' + esc(menu.code) +
                (menu.moduleName ? ' · ' + esc(menu.moduleName) : ' · Standalone') + '</div></div></div>';
        }
        function filteredMenus(query) {
            const q = query.trim().toLowerCase();
            if (!q) return menus;
            return menus.filter(m => [m.name, m.code, m.moduleName].some(v => String(v || '').toLowerCase().includes(q)));
        }
        function renderRoleMatrix() {
            roleHead.innerHTML = '<th>Menu / resource</th>' + roles.map(r =>
                '<th class="policy-column"><span class="policy-role-chip role">' + esc(r.name) + '</span><div class="policy-code mt-1">' + esc(r.code) + '</div></th>'
            ).join('');
            const rows = filteredMenus(roleSearch.value);
            roleRows.innerHTML = rows.length ? rows.map(m => '<tr data-search="' + esc((m.name + ' ' + m.code + ' ' + (m.moduleName || '')).toLowerCase()) + '"><td>' + menuCell(m) + '</td>' +
                roles.map(r => {
                    const key = r.id + ':' + m.id;
                    const checked = roleState.get(key) === true;
                    return '<td class="policy-cell"><input type="checkbox" class="policy-check role-check" data-role="' + r.id + '" data-menu="' + m.id + '" ' + (checked ? 'checked' : '') +
                        ' aria-label="' + esc(r.name + ' allow ' + m.name) + '"></td>';
                }).join('') + '</tr>').join('') :
                '<tr><td colspan="' + (roles.length + 1) + '" class="text-center text-secondary py-5">No menus match your search.</td></tr>';
            saveRoleButton.disabled = !project.value || roles.length === 0 || dirtyRoles.size === 0;
        }
        function renderUserMatrix() {
            userHead.innerHTML = '<th>Menu / resource</th>' + users.map(u =>
                '<th class="policy-column"><span class="policy-role-chip user">' + esc(u.displayName) + '</span><div class="policy-code mt-1">' + esc(u.userName) + '</div></th>'
            ).join('');
            const rows = filteredMenus(userSearch.value);
            userRows.innerHTML = rows.length ? rows.map(m => '<tr><td>' + menuCell(m) + '</td>' +
                users.map(u => {
                    const key = u.id + ':' + m.id;
                    const decision = userState.get(key) || 'inherit';
                    return '<td class="policy-cell"><select class="form-select form-select-sm policy-decision user-decision" data-user="' + u.id + '" data-menu="' + m.id + '" aria-label="' + esc(u.displayName + ' decision for ' + m.name) + '">' +
                        '<option value="inherit" ' + (decision === 'inherit' ? 'selected' : '') + '>Inherit</option>' +
                        '<option value="allow" ' + (decision === 'allow' ? 'selected' : '') + '>✓ Allow</option>' +
                        '<option value="deny" ' + (decision === 'deny' ? 'selected' : '') + '>✕ Deny</option></select></td>';
                }).join('') + '</tr>').join('') :
                '<tr><td colspan="' + (users.length + 1) + '" class="text-center text-secondary py-5">No menus match your search.</td></tr>';
            saveUserButton.disabled = !project.value || users.length === 0 || dirtyUsers.size === 0;
        }
        async function loadRoleMatrix(token) {
            const nextState = new Map();
            const results = await Promise.all(roles.map(async r => {
                const items = await get(requestUrl('role', project.value, r.id));
                return { roleId: r.id, items };
            }));
            if (token !== loadToken) return; // a newer project was selected meanwhile
            for (const result of results)
                for (const item of result.items) nextState.set(result.roleId + ':' + item.menuItemId, !!item.isAllowed);
            roleState = nextState; dirtyRoles.clear();
            renderRoleMatrix();
        }
        async function loadUserMatrix(token) {
            const nextState = new Map();
            const results = await Promise.all(users.map(async u => {
                const items = await get(requestUrl('user', project.value, u.id));
                return { userId: u.id, items };
            }));
            if (token !== loadToken) return; // a newer project was selected meanwhile
            for (const result of results)
                for (const item of result.items) nextState.set(result.userId + ':' + item.menuItemId, item.decision || 'inherit');
            userState = nextState; dirtyUsers.clear();
            renderUserMatrix();
        }
        async function loadProject() {
            const token = ++loadToken;
            menus = []; roles = []; users = []; roleState = new Map(); userState = new Map();
            dirtyRoles.clear(); dirtyUsers.clear();
            renderRoleMatrix(); renderUserMatrix();
            saveRoleButton.disabled = true; saveUserButton.disabled = true;
            if (!project.value) {
                notice('Select a project, then select a tenant to load role-wise and user-wise menu access.', 'info');
                return;
            }
            if (!tenant.value) {
                notice('Select a tenant assigned to this project.', 'info');
                roleRows.innerHTML = '<tr><td colspan="2" class="text-center text-secondary py-5">Choose a tenant to load the role matrix.</td></tr>';
                userRows.innerHTML = '<tr><td colspan="2" class="text-center text-secondary py-5">Choose a tenant to load the user matrix.</td></tr>';
                return;
            }

            roleRows.innerHTML = '<tr><td colspan="2" class="text-center text-secondary py-5">Loading project menus and role access…</td></tr>';
            userRows.innerHTML = '<tr><td colspan="2" class="text-center text-secondary py-5">Loading project menus and user access…</td></tr>';
            notice('Loading project access data…', 'info');

            const data = await get(requestUrl('lookups', project.value));
            if (token !== loadToken) return;
            menus = data.menus || [];
            roles = data.roles || [];
            users = data.users || [];
            renderRoleMatrix();
            renderUserMatrix();

            await Promise.all([loadRoleMatrix(token), loadUserMatrix(token)]);
            if (token !== loadToken) return;
            notice('Loaded ' + menus.length + ' menus, ' + roles.length + ' roles, and ' + users.length + ' users.' +
                (users.length ? '' : ' No active users have a role assignment for this project or its tenant.'));
        }

        roleRows.addEventListener('change', event => {
            const input = event.target.closest('.role-check');
            if (!input) return;
            const key = input.dataset.role + ':' + input.dataset.menu;
            roleState.set(key, input.checked);
            dirtyRoles.add(Number(input.dataset.role));
            saveRoleButton.disabled = false;
        });
        function handleUserDecisionChange(event) {
            const input = event.target.closest('.user-decision');
            if (!input || !userRows.contains(input)) return;

            userState.set(input.dataset.user + ':' + input.dataset.menu, input.value);
            dirtyUsers.add(Number(input.dataset.user));
            // Keep the button enabled even when Select2 emits a jQuery change event.
            saveUserButton.disabled = !(project.value && tenant.value && dirtyUsers.size > 0);
        }

        // The application applies Select2 to dropdowns globally. Select2 emits jQuery
        // change events, which may not reach a native addEventListener handler.
        if (window.jQuery) {
            window.jQuery(userRows)
                .off('change.menuPolicyUserAccess', '.user-decision')
                .on('change.menuPolicyUserAccess', '.user-decision', handleUserDecisionChange);
        } else {
            userRows.addEventListener('change', handleUserDecisionChange);
        }
        roleSearch.addEventListener('input', renderRoleMatrix);
        userSearch.addEventListener('input', renderUserMatrix);

        // A project can be assigned to multiple tenants. Load that tenant list first.
        async function loadTenants() {
            ++loadToken;
            menus = []; roles = []; users = []; roleState = new Map(); userState = new Map();
            dirtyRoles.clear(); dirtyUsers.clear();
            saveRoleButton.disabled = true; saveUserButton.disabled = true;
            tenant.disabled = true;
            options(tenant, [], x => x.name, project.value ? 'Loading assigned tenants…' : 'Select a project first');
            roleRows.innerHTML = '<tr><td colspan="2" class="text-center text-secondary py-5">Select a project and tenant to load access.</td></tr>';
            userRows.innerHTML = '<tr><td colspan="2" class="text-center text-secondary py-5">Select a project and tenant to load access.</td></tr>';
            if (!project.value) { notice('Select a project first.', 'info'); return; }
            try {
                const items = await get(requestUrl('tenants', project.value));
                options(tenant, items, x => x.code + ' — ' + x.name, 'Select a tenant…');
                tenant.disabled = items.length === 0;
                if (items.length === 0) notice('No active tenants are assigned to this project.', 'warning');
                else notice(items.length + ' tenant(s) use this project. Select one to load its access.', 'info');
                refreshSelect2(tenant);
            } catch (error) {
                tenant.disabled = true;
                notice(error.message, 'danger');
            }
        }

        bindChange(project, () => loadTenants());
        bindChange(tenant, () => {
            loadProject().catch(error => {
                roleRows.innerHTML = '<tr><td colspan="2" class="text-center text-danger py-5">' + esc(error.message) + '</td></tr>';
                userRows.innerHTML = '<tr><td colspan="2" class="text-center text-danger py-5">' + esc(error.message) + '</td></tr>';
                notice(error.message, 'danger');
            });
        });

        saveRoleButton.addEventListener('click', async () => {
            saveRoleButton.disabled = true;
            try {
                for (const roleId of dirtyRoles) {
                    const items = menus.map(m => ({ menuItemId: m.id, isAllowed: roleState.get(roleId + ':' + m.id) === true }));
                    await post(saveRoleUrl, { projectId: Number(project.value), roleId, items });
                }
                dirtyRoles.clear(); renderRoleMatrix();
                notice('Role-wise menu permissions saved successfully.');
            } catch (error) { notice(error.message, 'danger'); renderRoleMatrix(); }
        });
        saveUserButton.addEventListener('click', async () => {
            if (!project.value || !tenant.value || dirtyUsers.size === 0) {
                notice('Change at least one user decision before saving.', 'warning');
                return;
            }

            const pendingUserIds = Array.from(dirtyUsers);
            saveUserButton.disabled = true;
            saveUserButton.innerHTML = '<span class="spinner-border spinner-border-sm me-2" aria-hidden="true"></span>Saving overrides…';
            try {
                for (const userId of pendingUserIds) {
                    const items = menus.map(m => ({ menuItemId: m.id, decision: userState.get(userId + ':' + m.id) || 'inherit' }));
                    await post(saveUserUrl, { projectId: Number(project.value), userId, items });
                }
                dirtyUsers.clear();
                notice('User-wise overrides saved successfully.');
            } catch (error) {
                notice(error.message || 'Could not save user overrides.', 'danger');
            } finally {
                saveUserButton.innerHTML = '<span aria-hidden="true">✓</span> Save user overrides';
                renderUserMatrix();
            }
        });

        get(requestUrl('projects', 0)).then(items => {
            options(project, items, x => x.name + ' (' + x.code + ')', 'Choose a project…');
            options(tenant, [], x => x.name, 'Select a project first');
        }).catch(error => notice(error.message, 'danger'));
    });
</script>
